<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouveau test disponible</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f2ff; font-family:'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f2ff; padding:40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%;">

                    <!-- HEADER LOGO -->
                    <tr>
                        <td align="center" style="padding-bottom:24px;">
                            <span style="font-size:22px; font-weight:800; color:#4f46e5; letter-spacing:-0.5px;">
                                🧠 Inner<span style="color:#6366f1;">Track</span>
                            </span>
                        </td>
                    </tr>

                    <!-- CARTE PRINCIPALE -->
                    <tr>
                        <td style="background:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 8px 40px rgba(99,102,241,0.12);">

                            <!-- BANNIÈRE -->
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="background:linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); padding:48px 40px; text-align:center;">
                                        <div style="background:rgba(255,255,255,0.15); display:inline-block; border-radius:50%; width:64px; height:64px; line-height:64px; font-size:32px; margin-bottom:16px;">🆕</div>
                                        <h1 style="margin:0; color:#ffffff; font-size:26px; font-weight:700; letter-spacing:-0.5px;">
                                            Nouveau test disponible
                                        </h1>
                                        <p style="margin:8px 0 0; color:rgba(255,255,255,0.75); font-size:14px;">
                                            Découvrez-le dès maintenant
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- CONTENU -->
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="padding:40px;">

                                        <p style="margin:0 0 8px; font-size:18px; color:#1e1b4b; font-weight:600;">
                                            Bonjour {{ prenom }} 👋
                                        </p>
                                        <p style="margin:0 0 28px; font-size:15px; color:#6b7280; line-height:1.6;">
                                            Un nouveau test psychologique vient d'être publié sur la plateforme. Il est maintenant disponible et vous attend !
                                        </p>

                                        <!-- CARD TEST -->
                                        <table width="100%" cellpadding="0" cellspacing="0" style="background:linear-gradient(135deg,#eef2ff,#f5f3ff); border-radius:16px; border:1px solid #e0e7ff;">
                                            <tr>
                                                <td style="padding:24px 28px;">
                                                    <p style="margin:0 0 4px; font-size:11px; font-weight:700; color:#6366f1; text-transform:uppercase; letter-spacing:1px;">
                                                        📋 Test disponible
                                                    </p>
                                                    <p style="margin:0 0 8px; font-size:20px; font-weight:700; color:#1e1b4b;">
                                                        {{ titre_test }}
                                                    </p>
                                                    <span style="display:inline-block; background:#6366f1; color:#fff; font-size:12px; font-weight:600; padding:4px 12px; border-radius:20px;">
                                                        {{ type_test }}
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- FEATURES -->
                                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:24px;">
                                            <tr>
                                                <td style="padding:12px; background:#fafafa; border-radius:10px; width:33%;" align="center">
                                                    <div style="font-size:20px;">⚡</div>
                                                    <div style="font-size:11px; color:#6b7280; margin-top:4px;">Rapide</div>
                                                </td>
                                                <td width="12"></td>
                                                <td style="padding:12px; background:#fafafa; border-radius:10px; width:33%;" align="center">
                                                    <div style="font-size:20px;">🤖</div>
                                                    <div style="font-size:11px; color:#6b7280; margin-top:4px;">Analyse IA</div>
                                                </td>
                                                <td width="12"></td>
                                                <td style="padding:12px; background:#fafafa; border-radius:10px; width:33%;" align="center">
                                                    <div style="font-size:20px;">🔒</div>
                                                    <div style="font-size:11px; color:#6b7280; margin-top:4px;">Confidentiel</div>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- CTA -->
                                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:32px;">
                                            <tr>
                                                <td align="center">
                                                    <a href="http://localhost:8000/testpsy"
                                                       style="display:inline-block; background:linear-gradient(135deg,#4f46e5,#7c3aed); color:#ffffff; text-decoration:none;
                                                              font-size:15px; font-weight:700; padding:16px 48px; border-radius:12px;
                                                              letter-spacing:0.3px; box-shadow:0 4px 16px rgba(99,102,241,0.4);">
                                                        Passer le test maintenant →
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>

                                        <p style="margin:28px 0 0; font-size:13px; color:#9ca3af; text-align:center; line-height:1.6;">
                                            Si vous ne souhaitez plus recevoir ces notifications,<br>
                                            vous pouvez les désactiver dans vos <a href="#" style="color:#6366f1; text-decoration:none;">paramètres de compte</a>.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td align="center" style="padding:28px 0 8px;">
                            <p style="margin:0; font-size:12px; color:#9ca3af;">
                                © 2026 <strong style="color:#6366f1;">InnerTrack</strong> — Plateforme de bien-être psychologique
                            </p>
                            <p style="margin:6px 0 0; font-size:11px; color:#c4c4c4;">
                                noreply@innertrack.com
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>