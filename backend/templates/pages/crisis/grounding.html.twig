{% extends 'base.html.twig' %}

{% block title %}{{ 'Crisis Mode'|trans }}{% endblock %}

{% block layout %}
<style>
    [x-cloak] { display: none !important; }
    .sanctuary-gradient {
        background: linear-gradient(135deg, #0d1c2e 0%, #006a61 100%);
    }
    .breathing-pulse {
        box-shadow: 0 0 80px rgba(134, 242, 228, 0.15);
    }
    @keyframes subtle-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    .animate-float {
        animation: subtle-float 6s ease-in-out infinite;
    }
</style>

<!-- Full screen takeover -->
<div class="fixed inset-0 z-50 sanctuary-gradient flex flex-col overflow-hidden" x-data="crisisMode()">
    
    <!-- Top Navigation -->
    <header class="fixed top-0 w-full z-50 flex justify-between items-center px-6 h-20">
        <a href="{{ path('app_dashboard') }}" class="w-12 h-12 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-md text-white active:scale-95 transition-transform hover:bg-white/20">
            <span class="material-symbols-outlined">close</span>
        </a>
        <div class="px-4 py-1 rounded-full bg-white/10 backdrop-blur-md">
            <span class="font-headline text-teal-300 text-sm font-semibold tracking-wide">{{ 'Crisis Mode'|trans }}</span>
        </div>
        <div class="w-12"></div> <!-- Spacer -->
    </header>

    <!-- Main Content Canvas -->
    <main class="relative flex-1 w-full flex flex-col items-center justify-center px-8 z-10">
        <!-- Abstract Background Glows (Optimized) -->
        <div class="absolute top-1/4 -left-20 w-80 h-80 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(99,102,241,0.2) 0%, rgba(99,102,241,0) 70%);"></div>
        <div class="absolute bottom-1/4 -right-20 w-80 h-80 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(20,184,166,0.2) 0%, rgba(20,184,166,0) 70%);"></div>

        <!-- Guiding Header -->
        <div class="text-center mb-16 relative z-10 transition-opacity duration-1000" :class="started ? 'opacity-0' : 'opacity-100'">
            <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-white tracking-tight mb-4">
                {{ 'Just Breathe.'|trans }}
            </h1>
            <p class="font-body text-blue-200/80 text-lg max-w-xs mx-auto leading-relaxed">
                {{ 'Follow the light. Let the tension melt away with each breath.'|trans }}
            </p>
        </div>

        <!-- Central Breathing Circle (4-7-8 Guidance) -->
        <div class="relative flex items-center justify-center z-10 my-8">
            <!-- Outer Ripple Rings -->
            <div class="absolute w-72 h-72 rounded-full border border-teal-300/10 transition-transform duration-1000" :style="'transform: scale(' + circleScale + ')'"></div>
            <div class="absolute w-80 h-80 rounded-full border border-teal-300/5 transition-transform duration-1000 opacity-50" :style="'transform: scale(' + (circleScale * 1.1) + ')'"></div>
            
            <!-- Main Breath Container -->
            <button x-cloak @click="startBreathing()" x-show="!started" class="w-64 h-64 rounded-full bg-white/5 backdrop-blur-2xl flex items-center justify-center breathing-pulse relative overflow-hidden animate-float hover:bg-white/10 transition-all border border-white/10">
                <div class="absolute inset-0 bg-gradient-to-br from-teal-400/20 to-indigo-400/20"></div>
                <div class="relative z-20 text-center">
                    <span class="block font-headline text-2xl font-bold text-teal-300 tracking-wider mb-1">{{ 'Start'|trans }}</span>
                </div>
            </button>

            <!-- Active Breathing -->
            <div x-cloak x-show="started" class="w-64 h-64 rounded-full bg-white/5 backdrop-blur-2xl flex items-center justify-center breathing-pulse relative overflow-hidden transition-transform duration-1000" :style="'transform: scale(' + circleScale + ')'">
                <div class="absolute inset-0 bg-gradient-to-br from-teal-400/20 to-indigo-400/20"></div>
                <!-- Instruction Text -->
                <div class="relative z-20 text-center">
                    <span class="block font-headline text-2xl font-bold text-teal-300 tracking-wider mb-1" x-text="instruction"></span>
                    <span class="block font-label text-xs uppercase tracking-[0.2em] text-blue-200/60" x-text="timer + ' {{ 'Seconds'|trans|escape('js') }}'"></span>
                </div>
            </div>
        </div>

        <!-- Secondary Information / Affirmation -->
        <div class="mt-16 text-center z-10 transition-opacity duration-1000" :class="started ? 'opacity-100' : 'opacity-0'">
            <p class="font-body italic text-blue-200/60 text-sm">
                {{ '"This feeling is temporary. You are safe."'|trans }}
            </p>
        </div>
    </main>

    <!-- Bottom Action Cluster -->
    <div class="absolute bottom-8 left-0 w-full px-8 flex flex-col gap-4 z-20 max-w-md mx-auto right-0">
        <!-- Finish and Log Button -->
        <button x-show="started" @click="logAndFinish()" class="w-full py-4 rounded-xl bg-white text-slate-900 font-headline font-bold text-lg shadow-[0px_20px_40px_rgba(0,0,0,0.2)] active:scale-[0.98] transition-all flex items-center justify-center gap-3">
            <span>{{ 'Finish & Log'|trans }}</span>
            <span class="material-symbols-outlined text-teal-600">check_circle</span>
        </button>
        
        <!-- Emergency SOS Button -->
        <button @click="showEmergency = true" class="w-full py-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 font-headline font-semibold text-sm uppercase tracking-widest flex items-center justify-center gap-3 backdrop-blur-sm hover:bg-red-500/20 transition-colors">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">emergency_home</span>
            {{ 'Emergency Support'|trans }}
        </button>
    </div>

    <!-- Emergency Modal -->
    <div x-show="showEmergency" style="display: none;" class="absolute inset-0 z-[100] bg-slate-900/90 backdrop-blur-lg flex items-center justify-center p-6">
        <div class="bg-slate-800 rounded-[2rem] p-8 max-w-sm w-full border border-slate-700 shadow-2xl relative">
            <button @click="showEmergency = false" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div class="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center mb-6 text-red-500">
                <span class="material-symbols-outlined text-3xl">emergency</span>
            </div>
            <h3 class="text-2xl font-bold mb-2 text-white">{{ 'Emergency Contacts'|trans }}</h3>
            <p class="text-slate-400 text-sm mb-6">{{ 'If you are in immediate danger, please reach out.'|trans }}</p>
            
            <div class="space-y-3">
                <a href="tel:112" class="flex items-center gap-4 p-4 rounded-xl bg-slate-700/50 hover:bg-slate-700 transition">
                    <div class="w-10 h-10 rounded-full bg-slate-600 flex items-center justify-center text-white"><span class="material-symbols-outlined text-sm">call</span></div>
                    <div>
                        <div class="font-bold text-white">112</div>
                        <div class="text-[10px] text-slate-400 uppercase tracking-widest">{{ 'General Emergency'|trans }}</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function crisisMode() {
    return {
        started: false,
        phase: 'idle',
        instruction: '...',
        timer: 0,
        circleScale: 1,
        cycles: 0,
        interval: null,
        showEmergency: false,

        startBreathing() {
            this.started = true;
            this.runCycle();
            
            fetch('{{ path("app_crisis_api_log") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mechanism: '4-7-8 Breathing' })
            });
        },

        logAndFinish() {
            fetch('{{ path("app_crisis_api_log") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mechanism: '4-7-8 Breathing', resolved: true, notes: 'Completed grounding session.' })
            }).then(() => {
                window.location.href = '{{ path("app_dashboard") }}';
            });
        },

        runCycle() {
            if (!this.started) return;
            
            // Inhale 4s
            this.phase = 'inhale';
            this.instruction = '{{ "Inhale"|trans|escape("js") }}';
            this.circleScale = 1.3;
            this.countdown(4, () => {
                // Hold 7s
                this.phase = 'hold';
                this.instruction = '{{ "Hold"|trans|escape("js") }}';
                this.circleScale = 1.3;
                this.countdown(7, () => {
                    // Exhale 8s
                    this.phase = 'exhale';
                    this.instruction = '{{ "Exhale"|trans|escape("js") }}';
                    this.circleScale = 1;
                    this.countdown(8, () => {
                        this.cycles++;
                        this.runCycle();
                    });
                });
            });
        },

        countdown(seconds, callback) {
            clearInterval(this.interval);
            this.timer = seconds;
            this.interval = setInterval(() => {
                this.timer--;
                if (this.timer <= 0) {
                    clearInterval(this.interval);
                    callback();
                }
            }, 1000);
        }
    }
}
</script>
{% endblock %}
