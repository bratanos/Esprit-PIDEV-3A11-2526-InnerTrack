{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ event.titre }} - InnerTrack{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto pb-24 space-y-8">

    <div>
        <a href="{{ path('app_event_index') }}" class="inline-flex items-center gap-1 text-xs font-bold text-on-surface-variant hover:text-primary transition-colors mb-4">
            <span class="material-symbols-outlined text-lg">arrow_back</span> Retour aux événements
        </a>
        <h2 class="text-3xl font-extrabold font-headline tracking-tighter">{{ event.titre }}</h2>
    </div>

    {# ── Check-in status banner ── #}
    {% if inscription %}
        {% if inscription.statut == 'CONFIRMÉ' %}
        <div class="flex items-center gap-4 p-5 bg-green-50 border border-green-200 rounded-[1.5rem]">
            <span class="material-symbols-outlined text-4xl text-green-500">check_circle</span>
            <div>
                <p class="font-extrabold text-green-700 text-sm">Vous êtes confirmé !</p>
                <p class="text-xs text-green-600 mt-0.5">Votre place est réservée pour cet événement.</p>
            </div>
        </div>
        {% elseif inscription.statut == 'EN_ATTENTE' %}
        <div class="flex items-center gap-4 p-5 bg-orange-50 border border-orange-200 rounded-[1.5rem]">
            <span class="material-symbols-outlined text-4xl text-orange-400">hourglass_empty</span>
            <div>
                <p class="font-extrabold text-orange-700 text-sm">Liste d'attente</p>
                <p class="text-xs text-orange-600 mt-0.5">Vous serez notifié si une place se libère.</p>
            </div>
        </div>
        {% endif %}
    {% else %}
        <div class="flex items-center gap-4 p-5 bg-indigo-50 border border-indigo-200 rounded-[1.5rem]">
            <span class="material-symbols-outlined text-4xl text-primary">info</span>
            <div>
                <p class="font-extrabold text-indigo-700 text-sm">Vous n'êtes pas encore inscrit</p>
                <p class="text-xs text-indigo-600 mt-0.5">Inscrivez-vous depuis la liste des événements.</p>
            </div>
        </div>
    {% endif %}

    {# ── Event card ── #}
    <div class="bg-white rounded-[2.5rem] border border-outline/20 shadow-sm p-8 lg:p-10 space-y-6">

        {% if event.image %}
        <div class="h-56 w-full rounded-2xl overflow-hidden">
            <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.titre }}" class="w-full h-full object-cover">
        </div>
        {% endif %}

        <div class="grid grid-cols-2 gap-6">
            <div>
                <p class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1">Type</p>
                <span class="px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider
                    {% if event.type.value == 1 %}bg-blue-50 text-blue-700
                    {% elseif event.type.value == 2 %}bg-green-50 text-green-700
                    {% elseif event.type.value == 3 %}bg-purple-50 text-purple-700
                    {% else %}bg-orange-50 text-orange-700{% endif %}">
                    {{ event.type.label() }}
                </span>
            </div>
            <div>
                <p class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1">Date</p>
                <p class="text-sm font-bold text-on-surface">{{ event.date|date('d MMMM Y')|capitalize }}</p>
            </div>
            <div>
                <p class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1">Capacité</p>
                <p class="text-sm font-bold text-on-surface">{{ event.capacite }} places</p>
            </div>
            <div>
                <p class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1">Statut</p>
                <span class="flex items-center gap-1.5 text-sm font-bold {{ event.statut ? 'text-green-600' : 'text-red-500' }}">
                    <span class="w-2 h-2 rounded-full {{ event.statut ? 'bg-green-500' : 'bg-red-500' }}"></span>
                    {{ event.statut ? 'Actif' : 'Inactif' }}
                </span>
            </div>
        </div>

        {% if event.description %}
        <div>
            <p class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-2">Description</p>
            <div class="p-5 bg-gray-50 rounded-2xl text-sm text-on-surface-variant leading-relaxed">
                {{ event.description }}
            </div>
        </div>
        {% endif %}

        {% if inscription and inscription.statut == 'CONFIRMÉ' and event.date < date() %}
        <div class="pt-4 border-t border-outline/20">
            <a href="{{ path('app_event_certificate', {id: event.id}) }}" target="_blank"
               class="w-full py-3.5 rounded-2xl bg-purple-50 text-purple-700 border border-purple-200 text-sm font-bold flex items-center justify-center gap-2 hover:bg-purple-100 transition-colors">
                <span class="material-symbols-outlined text-lg">verified</span> Télécharger mon attestation
            </a>
        </div>
        {% elseif not inscription and event.statut and event.date >= date() %}
        <div class="pt-4 border-t border-outline/20">
            <form method="post" action="{{ path('app_event_participate', {id: event.id}) }}">
                <button type="submit"
                        class="w-full py-3.5 rounded-2xl bg-primary text-white text-sm font-bold shadow-lg shadow-primary/20 hover:bg-indigo-700 active:scale-95 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">how_to_reg</span> S'inscrire à cet événement
                </button>
            </form>
        </div>
        {% endif %}
    </div>

</div>
{% endblock %}
