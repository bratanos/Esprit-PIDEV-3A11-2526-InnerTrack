{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Événements - InnerTrack{% endblock %}

{% block content %}
<div class="space-y-12 lg:space-y-16 max-w-7xl mx-auto pb-24">
    <!-- Header -->
    <section>
        <div class="flex items-baseline gap-3">
            <h2 class="text-4xl md:text-5xl font-headline font-extrabold text-on-surface tracking-tight leading-tight">Événements</h2>
            <span class="text-4xl">📅</span>
        </div>
        <p class="mt-4 text-on-surface-variant font-medium max-w-2xl">
            Découvrez nos conférences, ateliers et webinaires. Rejoignez la communauté et participez aux événements qui vous intéressent.
        </p>
    </section>

    <!-- Filters Section -->
    <section class="bg-white rounded-[2rem] border border-outline/20 p-6 shadow-sm mb-8">
        <form id="events-filter-form" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Search -->
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">search</span>
                <input type="text" name="q" placeholder="Rechercher un événement..." class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
            </div>

            <!-- Type Filter -->
            <div>
                <select name="type" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-600 appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23131313%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_auto] bg-no-repeat bg-[position:right_16px_center]">
                    <option value="">Tous les types</option>
                    <option value="1">Conférence</option>
                    <option value="2">Atelier</option>
                    <option value="3">Forum</option>
                    <option value="4">Webinaire</option>
                </select>
            </div>

            <!-- Date Period -->
            <div>
                <select name="period" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-600 appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23131313%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_auto] bg-no-repeat bg-[position:right_16px_center]">
                    <option value="">Toutes les périodes</option>
                    <option value="upcoming">À venir</option>
                    <option value="past">Passés</option>
                </select>
            </div>

            <!-- Availability Filter -->
            <div>
                <select name="avail" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-gray-600 appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23131313%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_auto] bg-no-repeat bg-[position:right_16px_center]">
                    <option value="">Toute disponibilité</option>
                    <option value="available">Places disponibles</option>
                    <option value="full">Complet</option>
                </select>
            </div>
        </form>
    </section>

    <!-- Events Grid Container (AJAX Target) -->
    <div id="events-grid-container" class="relative min-h-[400px]">
        <!-- Loading Overlay -->
        <div id="events-loading" class="absolute inset-0 bg-white/60 backdrop-blur-sm z-20 flex flex-col items-center justify-center rounded-[3rem] hidden transition-opacity">
            <div class="w-12 h-12 border-4 border-primary/30 border-t-primary rounded-full animate-spin"></div>
            <p class="mt-4 font-bold text-primary animate-pulse">Recherche en cours...</p>
        </div>

        <!-- The Grid -->
        <div id="events-grid-content">
            {{ include('pages/events/_events_grid.html.twig') }}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('events-filter-form');
    const container = document.getElementById('events-grid-content');
    const loading = document.getElementById('events-loading');
    
    // Timeout for search debouncing (prevent requesting on every keypress immediately)
    let timeoutId;

    function fetchFilteredEvents() {
        // Show loader
        loading.classList.remove('hidden');
        container.style.opacity = '0.5';

        // Prepare URL with query params
        const params = new URLSearchParams(new FormData(form));
        const url = `{{ path('app_event_filter') }}?${params.toString()}`;

        // Fetch data
        fetch(url, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Network response was not ok');
            return response.text();
        })
        .then(html => {
            // Update the DOM
            container.innerHTML = html;
            
            // Clean up loader
            loading.classList.add('hidden');
            container.style.opacity = '1';

            // Optional: update URL in browser history silently
            window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
        })
        .catch(error => {
            console.error('Error fetching events:', error);
            loading.classList.add('hidden');
            container.style.opacity = '1';
        });
    }

    // Attach event listeners to all form inputs
    const inputs = form.querySelectorAll('input, select');
    inputs.forEach(input => {
        input.addEventListener(input.type === 'text' ? 'input' : 'change', function() {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(fetchFilteredEvents, 300); // 300ms debounce
        });
    });

    // Check if there are query params on initial load and set form values
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.toString().length > 0) {
        for (const [key, value] of urlParams.entries()) {
            const input = form.elements[key];
            if (input) input.value = value;
        }
        fetchFilteredEvents();
    }
    // Chatbot functionality
    const chatToggle = document.getElementById('chatbot-toggle');
    const chatWindow = document.getElementById('chatbot-window');
    const chatClose = document.getElementById('chatbot-close');
    const chatInput = document.getElementById('chatbot-input');
    const chatSend = document.getElementById('chatbot-send');
    const chatMessages = document.getElementById('chatbot-messages');
    
    const sessionId = 'session_' + Math.random().toString(36).substr(2, 9);
    
    function toggleChat() {
        chatWindow.classList.toggle('hidden');
        chatWindow.classList.toggle('flex');
        if (!chatWindow.classList.contains('hidden')) {
            chatInput.focus();
        }
    }
    
    chatToggle.addEventListener('click', toggleChat);
    chatClose.addEventListener('click', toggleChat);
    
    function addMessage(text, isUser = false) {
        const msgDiv = document.createElement('div');
        msgDiv.className = isUser 
            ? 'bg-primary text-white self-end p-3 rounded-2xl rounded-tr-sm max-w-[80%] text-sm shadow-sm' 
            : 'bg-white text-gray-800 border border-gray-100 self-start p-3 rounded-2xl rounded-tl-sm max-w-[80%] text-sm shadow-sm';
        msgDiv.textContent = text;
        chatMessages.appendChild(msgDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    
    async function sendMessage() {
        const message = chatInput.value.trim();
        if (!message) return;
        
        // Add user message
        addMessage(message, true);
        chatInput.value = '';
        
        // Add typing indicator
        const typingDiv = document.createElement('div');
        typingDiv.className = 'bg-white text-gray-800 border border-gray-100 self-start p-3 rounded-2xl rounded-tl-sm max-w-[80%] text-sm shadow-sm opacity-50';
        typingDiv.id = 'typing-indicator';
        typingDiv.textContent = '...';
        chatMessages.appendChild(typingDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        
        try {
            const response = await fetch('http://127.0.0.1:8001/interact', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    session_id: sessionId,
                    message: message
                })
            });
            
            const data = await response.json();
            
            // Remove typing indicator
            const ind = document.getElementById('typing-indicator');
            if (ind) ind.remove();
            
            // Add bot response
            addMessage(data.response, false);
            
        } catch (error) {
            const ind = document.getElementById('typing-indicator');
            if (ind) ind.remove();
            addMessage('Erreur: Impossible de contacter l\'assistant.', false);
            console.error('Chat error:', error);
        }
    }
    
    chatSend.addEventListener('click', sendMessage);
    chatInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
    });

});
</script>

<!-- Chatbot Widget -->
<div id="chatbot-widget" class="fixed bottom-6 right-6 z-50">
    <button id="chatbot-toggle" class="bg-primary text-white w-14 h-14 rounded-full shadow-lg flex items-center justify-center hover:bg-primary/90 transition-colors">
        <span class="material-symbols-outlined text-3xl">chat</span>
    </button>
    
    <div id="chatbot-window" class="hidden absolute bottom-16 right-0 w-80 md:w-96 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex-col h-[500px]">
        <div class="bg-primary text-white p-4 flex justify-between items-center">
            <h3 class="font-bold">InnerTrack Assistant</h3>
            <button id="chatbot-close" class="text-white hover:text-gray-200">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        
        <div id="chatbot-messages" class="flex-1 p-4 overflow-y-auto bg-gray-50 flex flex-col gap-3">
            <div class="bg-white text-gray-800 border border-gray-100 self-start p-3 rounded-2xl rounded-tl-sm max-w-[80%] text-sm shadow-sm">
                Bonjour! Je suis l'assistant AI InnerTrack. Avez-vous besoin d'aide avec nos événements?
            </div>
        </div>
        
        <div class="p-3 bg-white border-t border-gray-100 flex gap-2">
            <input type="text" id="chatbot-input" class="flex-1 px-3 py-2 bg-gray-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:outline-none" placeholder="Posez votre question...">
            <button id="chatbot-send" class="bg-primary text-white w-10 flex items-center justify-center rounded-xl hover:bg-primary/90">
                <span class="material-symbols-outlined">send</span>
            </button>
        </div>
    </div>
</div>

{% endblock %}
