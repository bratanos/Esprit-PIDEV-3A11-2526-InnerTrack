{% extends 'layouts/auth.html.twig' %}

{% block title %}Connexion - Mieux-être{% endblock %}

{% block body %}
<div class="relative w-full max-w-lg">
    <!-- Ambient Shadow / Soft Glow background -->
    <div class="absolute inset-0 bg-gradient-to-br from-cyan-400/20 to-emerald-400/20 blur-3xl opacity-50 rounded-[3rem]"></div>
    
    <div class="relative bg-white/80 backdrop-blur-xl rounded-[2rem] shadow-[0_32px_64px_-16px_rgba(0,104,118,0.08)] p-10 lg:p-14 border border-white/50">
        <!-- Logo -->
        <div class="flex justify-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-50 to-white flex items-center justify-center shadow-sm border border-cyan-100/50">
                <img src="{{ asset('images/innertracklogo1.png') }}" alt="InnerTrack Logo" class="w-10 h-10 object-contain"/>
            </div>
        </div>

        <div class="text-center mb-10">
            <h1 class="text-3xl font-semibold text-slate-800 tracking-tight mb-3 font-['Inter']">Bienvenue !</h1>
            <p class="text-slate-500 text-sm font-medium">Votre espace de sérénité et de santé mentale.</p>
        </div>

        {% if error %}
            <div class="mb-6 p-4 rounded-2xl bg-red-50 text-red-600 text-sm font-medium border border-red-100 flex items-center gap-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-2xl bg-emerald-50 text-emerald-700 text-sm font-medium border border-emerald-100 flex items-center gap-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}" class="space-y-6">
            <div class="space-y-2">
                <label for="email" class="block text-sm font-medium text-slate-700 ml-1">Adresse Email</label>
                <div class="relative group">
                    <input type="email" value="{{ last_username }}" name="email" id="email" required autofocus
                           class="w-full h-14 bg-slate-50 border-0 rounded-2xl px-5 text-slate-800 placeholder-slate-400 focus:ring-0 focus:bg-white transition-all duration-300 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.15)] peer"
                           style="outline: none;">
                    <div class="absolute inset-0 rounded-2xl border border-slate-200 pointer-events-none peer-focus:border-cyan-400 transition-colors duration-300"></div>
                </div>
            </div>

            <div class="space-y-2">
                <div class="flex items-center justify-between ml-1">
                    <label for="password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
                    <a href="{{ path('app_forgot_password') }}" class="text-sm font-medium text-cyan-600 hover:text-cyan-700 transition-colors">Oublié ?</a>
                </div>
                <div class="relative group">
                    <input type="password" name="password" id="password" required
                           class="w-full h-14 bg-slate-50 border-0 rounded-2xl px-5 text-slate-800 placeholder-slate-400 focus:ring-0 focus:bg-white transition-all duration-300 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.15)] peer"
                           style="outline: none;">
                    <div class="absolute inset-0 rounded-2xl border border-slate-200 pointer-events-none peer-focus:border-cyan-400 transition-colors duration-300"></div>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="pt-4">
                <button type="submit" class="relative group w-full h-14 rounded-2xl bg-gradient-to-r from-[#006876] to-[#00BCD4] text-white font-semibold text-lg hover:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.5)] transition-all duration-300 overflow-hidden">
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
                    <span class="relative">Se connecter</span>
                </button>
            </div>
            
            <div class="relative py-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="bg-white px-4 text-slate-500 font-medium">Nouveau sur InnerTrack ?</span>
                </div>
            </div>

            <a href="{{ path('app_register') }}" class="flex items-center justify-center w-full h-14 rounded-2xl bg-emerald-50 text-emerald-700 font-semibold text-lg border border-emerald-100 hover:bg-emerald-100 hover:border-emerald-200 transition-colors duration-300">
                Créer un compte
            </a>
        </form>
    </div>
</div>
{% endblock %}
