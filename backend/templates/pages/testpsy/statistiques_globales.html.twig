
{% extends 'layouts/dashboard.html.twig' %}

{% block header_title %}Statistiques Globales{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto pb-24">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold font-headline tracking-tight text-on-surface">Statistiques Globales</h1>
            <p class="text-sm text-on-surface-variant mt-1">Aperçu général de l'utilisation des tests psychologiques</p>
        </div>
        <a href="{{ path('testpsy_index') }}"
           class="inline-flex items-center gap-2 text-sm font-bold text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">arrow_back</span> Retour aux tests
        </a>
    </div>

    <!-- Top Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <div class="bg-gradient-to-br from-primary to-indigo-600 rounded-[2rem] p-6 text-white shadow-lg shadow-indigo-200 flex items-center gap-5">
            <div class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
                <span class="material-symbols-outlined text-3xl">psychology</span>
            </div>
            <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-100 mb-1">Total Passages</p>
                <p class="text-4xl font-extrabold font-headline">{{ stats_globales.total_passages }}</p>
            </div>
        </div>

        <div class="bg-white rounded-[2rem] p-6 border border-outline/20 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 rounded-[1.25rem] bg-amber-50 text-amber-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">star</span>
            </div>
            <div class="min-w-0">
                <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Test le plus Populaire</p>
                <p class="text-xl font-extrabold text-on-surface font-headline truncate">{{ stats_globales.populaire ?: 'Aucun test passé' }}</p>
            </div>
        </div>

        <div class="bg-white rounded-[2rem] p-6 border border-outline/20 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 rounded-[1.25rem] bg-green-50 text-green-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">analytics</span>
            </div>
            <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Tests Actifs</p>
                <p class="text-2xl font-extrabold text-on-surface font-headline">{{ passages|length }}</p>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

        <!-- Bar Chart : Passages -->
        <div class="bg-white rounded-[2rem] p-8 border border-outline/20 shadow-sm">
            <h3 class="text-lg font-extrabold font-headline text-on-surface mb-1 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">bar_chart</span>
                Passages par test
            </h3>
            <p class="text-xs text-on-surface-variant mb-6">Nombre de fois que chaque test a été passé</p>
            <div id="chart_passages" style="width:100%; height:320px;"></div>
        </div>

        <!-- Donut Chart : Moyennes -->
        <div class="bg-white rounded-[2rem] p-8 border border-outline/20 shadow-sm">
            <h3 class="text-lg font-extrabold font-headline text-on-surface mb-1 flex items-center gap-2">
                <span class="material-symbols-outlined text-green-600">pie_chart</span>
                Score moyen par test
            </h3>
            <p class="text-xs text-on-surface-variant mb-6">Pourcentage moyen obtenu par les utilisateurs</p>
            <div id="chart_moyennes" style="width:100%; height:320px;"></div>
        </div>

    </div>

    <!-- Combo Chart -->
    <div class="bg-white rounded-[2rem] p-8 border border-outline/20 shadow-sm mb-10">
        <h3 class="text-lg font-extrabold font-headline text-on-surface mb-1 flex items-center gap-2">
            <span class="material-symbols-outlined text-indigo-400">show_chart</span>
            Comparaison passages vs score moyen
        </h3>
        <p class="text-xs text-on-surface-variant mb-6">Vue combinée pour identifier les tests les plus utilisés et performants</p>
        <div id="chart_combo" style="width:100%; height:350px;"></div>
    </div>

</div>

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load('current', { packages: ['corechart', 'bar'] });
    google.charts.setOnLoadCallback(drawCharts);

    const passagesRaw = {{ passages|json_encode|raw }};
    const moyennesRaw = {{ moyennes|json_encode|raw }};

    function drawCharts() {
        drawPassages();
        drawMoyennes();
        drawCombo();
    }

    function drawPassages() {
        if (!passagesRaw.length) {
            document.getElementById('chart_passages').innerHTML = '<p class="text-center text-gray-400 mt-10">Aucune donnée disponible</p>';
            return;
        }

        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Test');
        data.addColumn('number', 'Passages');
        data.addColumn({ type: 'string', role: 'style' });
        data.addColumn({ type: 'string', role: 'tooltip' });

        const colors = ['#6366f1','#818cf8','#4f46e5','#7c3aed','#a78bfa','#c4b5fd','#8b5cf6','#ddd6fe'];
        passagesRaw.forEach(function(item, i) {
            data.addRow([
                item.titre.length > 22 ? item.titre.substring(0, 22) + '…' : item.titre,
                parseInt(item.nb_passages),
                'color: ' + colors[i % colors.length],
                item.titre + '\n' + item.nb_passages + ' passage(s)'
            ]);
        });

        var options = {
            chartArea: { left: 50, top: 20, right: 20, bottom: 80, width: '100%', height: '80%' },
            legend: { position: 'none' },
            bar: { groupWidth: '55%' },
            vAxis: {
                minValue: 0,
                gridlines: { color: '#f3f4f6', count: 5 },
                textStyle: { color: '#6b7280', fontSize: 11 }
            },
            hAxis: {
                textStyle: { color: '#6b7280', fontSize: 10 },
                slantedText: true,
                slantedTextAngle: 30
            },
            animation: { startup: true, duration: 800, easing: 'out' },
            backgroundColor: 'transparent',
            fontName: 'Inter, Arial, sans-serif'
        };

        var chart = new google.visualization.ColumnChart(document.getElementById('chart_passages'));
        chart.draw(data, options);
    }

    function drawMoyennes() {
        if (!moyennesRaw.length) {
            document.getElementById('chart_moyennes').innerHTML = '<p class="text-center text-gray-400 mt-10">Aucune donnée disponible</p>';
            return;
        }

        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Test');
        data.addColumn('number', 'Score moyen (%)');

        moyennesRaw.forEach(function(item) {
            data.addRow([item.titre, parseFloat(item.moyenne)]);
        });

        var options = {
            chartArea: { left: 20, top: 20, right: 20, bottom: 20, width: '100%', height: '90%' },
            pieHole: 0.45,
            colors: ['#6366f1','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316'],
            legend: {
                position: 'right',
                textStyle: { color: '#374151', fontSize: 11 },
                alignment: 'center'
            },
            pieSliceTextStyle: { color: '#fff', fontSize: 11, bold: true },
            tooltip: { showColorCode: true },
            animation: { startup: true, duration: 800, easing: 'out' },
            backgroundColor: 'transparent',
            fontName: 'Inter, Arial, sans-serif'
        };

        var chart = new google.visualization.PieChart(document.getElementById('chart_moyennes'));
        chart.draw(data, options);
    }

    function drawCombo() {
        if (!passagesRaw.length) {
            document.getElementById('chart_combo').innerHTML = '<p class="text-center text-gray-400 mt-10">Aucune donnée disponible</p>';
            return;
        }

        var moyennesMap = {};
        moyennesRaw.forEach(function(m) { moyennesMap[m.id_test] = parseFloat(m.moyenne); });

        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Test');
        data.addColumn('number', 'Passages');
        data.addColumn('number', 'Score moyen (%)');

        passagesRaw.forEach(function(item) {
            data.addRow([
                item.titre.length > 20 ? item.titre.substring(0, 20) + '…' : item.titre,
                parseInt(item.nb_passages),
                moyennesMap[item.id_test] || 0
            ]);
        });

        var options = {
            chartArea: { left: 60, top: 20, right: 60, bottom: 80, width: '100%', height: '75%' },
            seriesType: 'bars',
            series: {
                0: { color: '#6366f1', targetAxisIndex: 0 },
                1: { type: 'line', color: '#10b981', lineWidth: 3, pointSize: 7, targetAxisIndex: 1 }
            },
            vAxes: {
                0: { title: 'Passages', textStyle: { color: '#6b7280', fontSize: 11 }, gridlines: { color: '#f3f4f6' } },
                1: { title: 'Score (%)', textStyle: { color: '#6b7280', fontSize: 11 }, minValue: 0, maxValue: 100 }
            },
            hAxis: {
                textStyle: { color: '#6b7280', fontSize: 10 },
                slantedText: true,
                slantedTextAngle: 30
            },
            legend: { position: 'top', textStyle: { color: '#374151', fontSize: 11 } },
            bar: { groupWidth: '50%' },
            animation: { startup: true, duration: 800, easing: 'out' },
            backgroundColor: 'transparent',
            fontName: 'Inter, Arial, sans-serif'
        };

        var chart = new google.visualization.ComboChart(document.getElementById('chart_combo'));
        chart.draw(data, options);
    }

    window.addEventListener('resize', drawCharts);
</script>
{% endblock %}
