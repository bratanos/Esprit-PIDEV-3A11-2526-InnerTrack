{% extends 'layouts/auth.html.twig' %}

{% block title %}Mot de passe oublié - InnerTrack{% endblock %}

{% block body %}
<div class="relative w-full max-w-lg">
    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-400/20 to-emerald-400/20 blur-3xl opacity-50 rounded-[3rem]"></div>
    
    <div class="relative bg-white/80 backdrop-blur-xl rounded-[2rem] shadow-[0_32px_64px_-16px_rgba(0,104,118,0.08)] p-10 lg:p-14 border border-white/50 text-center">
        
        <div class="mx-auto w-20 h-20 rounded-full bg-emerald-50 flex items-center justify-center mb-6 border-4 border-white shadow-sm">
            <svg class="w-10 h-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
            </svg>
        </div>

        <h1 class="text-3xl font-semibold text-slate-800 tracking-tight mb-3 font-['Inter']">Mot de passe oublié ?</h1>
        <p class="text-slate-500 text-sm font-medium mb-8">Entrez votre adresse email et nous vous enverrons un code de réinitialisation.</p>

        <form method="post" action="{{ path('app_forgot_password') }}" class="space-y-6 text-left">
            <div class="space-y-2">
                <label for="email" class="block text-sm font-medium text-slate-700 ml-1">Adresse Email</label>
                <div class="relative group">
                    <input type="email" name="email" id="email" required autofocus
                           class="w-full h-14 bg-slate-50 border-0 rounded-2xl px-5 text-slate-800 placeholder-slate-400 focus:ring-0 focus:bg-white transition-all duration-300 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.15)] peer"
                           style="outline: none;">
                    <div class="absolute inset-0 rounded-2xl border border-slate-200 pointer-events-none peer-focus:border-cyan-400 transition-colors duration-300"></div>
                </div>
            </div>

            <button type="submit" class="w-full h-14 rounded-2xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-lg hover:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.5)] transition-all duration-300">
                Envoyer le code
            </button>
            
            <div class="text-center pt-2">
                <a href="{{ path('app_login') }}" class="text-sm font-medium text-slate-500 hover:text-cyan-600 transition flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Retour à la connexion
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
