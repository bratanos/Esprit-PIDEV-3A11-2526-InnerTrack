{% extends 'layouts/auth.html.twig' %}

{% block title %}Vérification - InnerTrack{% endblock %}

{% block body %}
<div class="relative w-full max-w-lg">
    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-400/20 to-emerald-400/20 blur-3xl opacity-50 rounded-[3rem]"></div>
    
    <div class="relative bg-white/80 backdrop-blur-xl rounded-[2rem] shadow-[0_32px_64px_-16px_rgba(0,104,118,0.08)] p-10 lg:p-14 border border-white/50 text-center">
        
        <div class="mx-auto w-20 h-20 rounded-full bg-cyan-50 flex items-center justify-center mb-6 border-4 border-white shadow-sm">
            <svg class="w-10 h-10 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
        </div>

        <h1 class="text-3xl font-semibold text-slate-800 tracking-tight mb-3 font-['Inter']">Vérifiez votre email</h1>
        <p class="text-slate-500 text-sm font-medium mb-8">Nous avons envoyé un code à <strong>{{ email }}</strong></p>

        {% for message in app.flashes('error') %}
            <div class="mb-6 p-4 rounded-2xl bg-red-50 text-red-600 text-sm font-medium border border-red-100 flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_verify_email') }}" class="space-y-6">
            <input type="hidden" name="email" value="{{ email }}">
            
            <div class="space-y-2">
                <div class="relative group">
                    <input type="text" name="code" id="code" required autofocus placeholder="Code à 6 chiffres" maxlength="6"
                           class="w-full h-16 bg-slate-50 border-0 rounded-2xl px-5 text-center text-3xl tracking-[1em] font-semibold text-slate-800 placeholder-slate-300 focus:ring-0 focus:bg-white transition-all duration-300 shadow-[inset_0_2px_4px_rgba(0,0,0,0.02)] focus:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.15)] peer"
                           style="outline: none;">
                    <div class="absolute inset-0 rounded-2xl border border-slate-200 pointer-events-none peer-focus:border-cyan-400 transition-colors duration-300"></div>
                </div>
            </div>

            <button type="submit" class="w-full h-14 rounded-2xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-lg hover:shadow-[0_8px_24px_-8px_rgba(0,188,212,0.5)] transition-all duration-300">
                Vérifier mon compte
            </button>
        </form>
    </div>
</div>
{% endblock %}
