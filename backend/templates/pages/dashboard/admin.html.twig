{% extends 'layouts/dashboard.html.twig' %}

{% block header_title %}Panneau d'Administration{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative">
            <div class="absolute left-0 top-0 h-full w-2 rounded-l-[1.5rem] bg-cyan-500"></div>
            <div class="pl-4">
                <div class="text-[#3c494c] text-xs font-semibold uppercase tracking-wider mb-1">Utilisateurs Totaux</div>
                <div class="text-3xl font-bold text-[#0e1e1e]">{{ totalUsers }}</div>
            </div>
        </div>
        
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative">
            <div class="absolute left-0 top-0 h-full w-2 rounded-l-[1.5rem] bg-emerald-500"></div>
            <div class="pl-4">
                <div class="text-[#3c494c] text-xs font-semibold uppercase tracking-wider mb-1">Clients / Patients</div>
                <div class="text-3xl font-bold text-[#0e1e1e]">{{ totalClients }}</div>
            </div>
        </div>

        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative">
            <div class="absolute left-0 top-0 h-full w-2 rounded-l-[1.5rem] bg-teal-600"></div>
            <div class="pl-4">
                <div class="text-[#3c494c] text-xs font-semibold uppercase tracking-wider mb-1">Thérapeutes</div>
                <div class="text-3xl font-bold text-[#0e1e1e]">{{ totalTherapists }}</div>
            </div>
        </div>

        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative">
            <div class="absolute left-0 top-0 h-full w-2 rounded-l-[1.5rem] bg-red-500"></div>
            <div class="pl-4">
                <div class="text-[#3c494c] text-xs font-semibold uppercase tracking-wider mb-1">Signalements Ouverts</div>
                <div class="text-3xl font-bold text-[#0e1e1e]">{{ pendingReports }}</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Status summary -->
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] lg:col-span-1">
            <h3 class="text-[#006876] font-bold text-lg mb-6">Répartition par statut</h3>
            
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-slate-600 font-medium">
                        <span class="w-3 h-3 rounded-full bg-emerald-500"></span> Actifs
                    </span>
                    <span class="font-bold text-lg">{{ activeCount }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-slate-600 font-medium">
                        <span class="w-3 h-3 rounded-full bg-amber-500"></span> En attente
                    </span>
                    <span class="font-bold text-lg">{{ pendingCount }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-slate-600 font-medium">
                        <span class="w-3 h-3 rounded-full bg-red-500"></span> Bloqués
                    </span>
                    <span class="font-bold text-lg text-red-600">{{ blockedCount }}</span>
                </div>
            </div>
        </div>

        <!-- Latest signups chart area -->
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] lg:col-span-2">
            <h3 class="text-[#006876] font-bold text-lg mb-6">Inscriptions récentes</h3>
            
            <div class="w-full text-left border-collapse">
               <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-2 flex">
                    <div class="w-1/2">Mois</div>
                    <div class="w-1/2 text-right">Inscriptions</div>
               </div>
               <div class="space-y-2">
               {% for m in monthly %}
                   <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-0">
                       <span class="font-medium text-slate-700">{{ m.month }}</span>
                       <span class="font-bold text-cyan-700 bg-cyan-50 px-3 py-1 rounded-full">{{ m.cnt }}</span>
                   </div>
               {% else %}
                   <div class="py-4 text-center text-slate-500">Aucune donnée récente.</div>
               {% endfor %}
               </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
