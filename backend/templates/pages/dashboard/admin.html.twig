{% extends 'layouts/dashboard.html.twig' %}

{% block header_title %}Panneau d'Administration{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto pb-24" x-data="adminSystem()">
    
    <!-- Tab Navigation: Premium Glassmorphism Bar -->
    <div class="sticky top-0 z-30 mb-10 -mx-2">
        <div class="bg-white/70 backdrop-blur-xl border border-white/20 rounded-[2.5rem] p-1.5 shadow-sm inline-flex items-center gap-1 mx-2">
            <button @click="activeTab = 'overview'" 
                :class="activeTab === 'overview' ? 'bg-primary text-white shadow-md shadow-primary/20' : 'text-on-surface-variant hover:bg-gray-50 hover:text-primary'"
                class="px-8 py-3 rounded-[2rem] text-sm font-bold transition-all duration-300 flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">dashboard</span> {{ 'dashboard.overview'|trans }}
            </button>
            <button @click="activeTab = 'users'" 
                :class="activeTab === 'users' ? 'bg-primary text-white shadow-md shadow-primary/20' : 'text-on-surface-variant hover:bg-gray-50 hover:text-primary'"
                class="px-8 py-3 rounded-[2rem] text-sm font-bold transition-all duration-300 flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">group</span> {{ 'dashboard.tabs.users'|trans }}
            </button>
            <button @click="activeTab = 'messages'" 
                :class="activeTab === 'messages' ? 'bg-primary text-white shadow-md shadow-primary/20' : 'text-on-surface-variant hover:bg-gray-50 hover:text-primary'"
                class="px-8 py-3 rounded-[2rem] text-sm font-bold transition-all duration-300 flex items-center gap-2 relative">
                <span class="material-symbols-outlined text-xl">chat_bubble</span> Messages 
                {% if messagingReports|length > 0 %}<span class="w-2 h-2 bg-red-500 rounded-full animate-pulse absolute -right-0 top-3"></span>{% endif %}
            </button>
            <button @click="activeTab = 'community'" 
                :class="activeTab === 'community' ? 'bg-primary text-white shadow-md shadow-primary/20' : 'text-on-surface-variant hover:bg-gray-50 hover:text-primary'"
                class="px-8 py-3 rounded-[2rem] text-sm font-bold transition-all duration-300 flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">forum</span> {{ 'dashboard.tabs.community'|trans }}
                {% if communityReports|length > 0 %}<span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse absolute -right-0 top-3"></span>{% endif %}
            </button>
            <button @click="activeTab = 'crud'" 
                :class="activeTab === 'crud' ? 'bg-amber-500 text-white shadow-md shadow-amber-200' : 'text-amber-600 hover:bg-amber-50'"
                class="px-8 py-3 rounded-[2rem] text-sm font-bold transition-all duration-300 flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">manage_accounts</span> CRUD
                <span class="text-[9px] bg-white/30 text-current px-2 py-0.5 rounded-full font-extrabold uppercase tracking-wider">Validation</span>
            </button>
        </div>
    </div>

    <!-- Tab Content -->
    <div x-show="activeTab === 'overview'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" class="space-y-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            {# ── Users card ─────────────────────────────────── #}
            <div class="bg-gradient-to-br from-primary/10 to-indigo-50/50 rounded-[2.5rem] p-1 w-full box-border">
                <div class="bg-white rounded-[2.4rem] p-8 h-full">
                    <div class="text-[10px] font-bold text-on-surface-variant tracking-[0.2em] uppercase mb-1">{{ 'dashboard.tabs.users'|trans }}</div>
                    <div class="text-4xl font-extrabold text-primary font-headline tracking-tighter">{{ totalUsers }}</div>
                    <div class="mt-4 text-[10px] font-medium text-green-600 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">trending_up</span>
                        +{{ newThisMonth }} this month
                    </div>
                    <div class="mt-2 flex gap-4 text-[10px] text-on-surface-variant">
                        <span>{{ totalClients }} clients</span>
                        <span>{{ totalTherapists }} therapists</span>
                    </div>
                </div>
            </div>

            {# ── Security card (real score: % active users) ── #}
            <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-outline/20">
                <div class="text-[10px] font-bold text-on-surface-variant tracking-[0.2em] uppercase mb-4">{{ 'dashboard.security_score'|trans }}</div>
                <div class="flex items-center gap-4">
                    <div class="relative w-16 h-16 shrink-0">
                        <svg viewBox="0 0 36 36" class="w-16 h-16 -rotate-90">
                            <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f1f5f9" stroke-width="3"/>
                            <circle cx="18" cy="18" r="15.9" fill="none"
                                stroke="{% if securityScore >= 80 %}#10b981{% elseif securityScore >= 60 %}#f59e0b{% else %}#ef4444{% endif %}"
                                stroke-width="3" stroke-dasharray="{{ securityScore }},100"
                                stroke-linecap="round"/>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center text-sm font-extrabold">{{ securityScore }}%</div>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold font-headline">{{ pendingReports }}</div>
                        <div class="text-[10px] text-on-surface-variant mt-1">open reports</div>
                        {% if pendingReports > 0 %}
                        <div class="flex items-center gap-1 mt-2 text-[10px] text-red-500 font-bold">
                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></span> Action needed
                        </div>
                        {% else %}
                        <div class="text-[10px] text-green-500 font-bold mt-2">✓ All clear</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── System Health card (real: DB latency) ──────── #}
            <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-outline/20">
                <div class="text-[10px] font-bold text-on-surface-variant tracking-[0.2em] uppercase mb-4">{{ 'dashboard.system_health'|trans }}</div>
                <div class="flex items-center gap-4">
                    <div class="relative w-16 h-16 shrink-0">
                        <svg viewBox="0 0 36 36" class="w-16 h-16 -rotate-90">
                            <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f1f5f9" stroke-width="3"/>
                            <circle cx="18" cy="18" r="15.9" fill="none"
                                stroke="{% if healthScore >= 80 %}#06b6d4{% elseif healthScore >= 60 %}#f59e0b{% else %}#ef4444{% endif %}"
                                stroke-width="3" stroke-dasharray="{{ healthScore }},100"
                                stroke-linecap="round"/>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center text-sm font-extrabold">{{ healthScore }}%</div>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold font-headline">{{ healthLabel }}</div>
                        <div class="text-[10px] text-on-surface-variant mt-1">DB latency: {{ dbLatencyMs }} ms</div>
                    </div>
                </div>
            </div>

            {# ── API Load card (real: msg/hr) ─────────────── #}
            <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-outline/20">
                <div class="text-[10px] font-bold text-on-surface-variant tracking-[0.2em] uppercase mb-4">{{ 'dashboard.api_load'|trans }}</div>
                <div class="flex items-center gap-4">
                    <div class="relative w-16 h-16 shrink-0">
                        <svg viewBox="0 0 36 36" class="w-16 h-16 -rotate-90">
                            <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f1f5f9" stroke-width="3"/>
                            <circle cx="18" cy="18" r="15.9" fill="none"
                                stroke="{% if apiLoadScore > 75 %}#ef4444{% elseif apiLoadScore > 40 %}#f59e0b{% else %}#10b981{% endif %}"
                                stroke-width="3" stroke-dasharray="{{ apiLoadScore }},100"
                                stroke-linecap="round"/>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center text-sm font-extrabold">{{ apiLoadScore }}%</div>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold font-headline">{{ apiLoadLabel }}</div>
                        <div class="text-[10px] text-on-surface-variant mt-1">{{ recentMessages }} msg / last hour</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[3rem] p-12 shadow-sm relative overflow-hidden">
            <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent)]"></div>
            <div class="relative">
                <div class="flex items-baseline justify-between mb-8">
                    <h3 class="text-2xl font-extrabold tracking-tight font-headline">Monthly Signups / Inscriptions mensuelles</h3>
                    <span class="text-[10px] text-on-surface-variant font-bold uppercase tracking-widest">Last 6 months</span>
                </div>
                {% if monthly|length > 0 %}
                <div class="flex items-end gap-3 h-64">
                    {% for m in monthly %}
                        {% set height = monthlyMax > 0 ? ((m.cnt / monthlyMax) * 100)|round : 0 %}
                        <div class="flex-1 group relative h-full flex flex-col justify-end items-center">
                            <div class="absolute -top-8 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-primary text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-sm whitespace-nowrap z-10">
                                {{ m.cnt }} user{{ m.cnt != 1 ? 's' : '' }}
                            </div>
                            <div class="w-full bg-primary/10 rounded-t-xl group-hover:bg-primary/30 transition-all duration-300" style="height: max(4px, {{ height }}%)"></div>
                            <div class="mt-3 text-[9px] font-bold uppercase tracking-widest text-on-surface-variant text-center">{{ m.month|split(' ')|first }}</div>
                        </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="h-64 flex items-center justify-center text-on-surface-variant text-sm">
                    No registration data yet / Aucune inscription enregistrée
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div x-show="activeTab === 'users'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4">
        <div class="bg-white rounded-[3rem] p-2 shadow-sm border border-outline/30">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1 p-2">
                {% for user in users %}
                <div class="flex flex-col p-8 rounded-[2.2rem] hover:bg-gray-50 group transition-all duration-300 border border-transparent hover:border-outline/50">
                    <div class="flex items-center gap-4 mb-6">
                        {% set pfp = user.profile_picture %}
                        {% set pfp_url = null %}
                        {% if pfp %}
                            {% if pfp starts with 'http' %}
                                {% set pfp_url = pfp %}
                            {% elseif pfp starts with '/uploads/' %}
                                {% set pfp_url = pfp %}
                            {% else %}
                                {% set pfp_url = '/uploads/profiles/' ~ pfp|split('\\')|last|split('/')|last %}
                            {% endif %}
                        {% endif %}

                        <div class="w-16 h-16 rounded-[1.25rem] bg-indigo-50 text-primary flex items-center justify-center font-bold text-xl group-hover:scale-105 transition-transform overflow-hidden">
                            {% if pfp_url %}
                                <img src="{{ pfp_url }}" alt="{{ user.first_name }}" class="w-full h-full object-cover">
                            {% else %}
                                {{ user.first_name|first|upper }}{{ user.last_name|first|upper }}
                            {% endif %}
                        </div>
                        <div>
                            <div class="text-lg font-extrabold text-on-surface leading-tight">{{ user.first_name }} {{ user.last_name }}</div>
                            <div class="text-[11px] text-on-surface-variant font-medium mt-0.5 truncate max-w-[140px]">{{ user.email }}</div>
                        </div>
                        <div class="ml-auto">
                            <button @click="blockUser({{ user.id }})" 
                                    class="p-3 rounded-2xl bg-white shadow-sm border border-outline/50 text-on-surface-variant hover:text-red-500 transition-all active:scale-90"
                                    title="{{ user.status == 'BLOCKED' ? 'Débloquer' : 'Bloquer' }}">
                                <span class="material-symbols-outlined text-[20px]">{{ user.status == 'BLOCKED' ? 'lock_open' : 'block' }}</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-3">
                        <span class="px-3.5 py-1.5 rounded-full text-[9px] font-bold uppercase tracking-[0.1em]
                            {% if 'ADMIN' in user.roles %} bg-purple-100/70 text-purple-700
                            {% elseif 'PSYCHOLOGUE' in user.roles %} bg-indigo-100/70 text-indigo-700
                            {% else %} bg-slate-100/70 text-slate-700
                            {% endif %}">
                            {{ user.roles|first|replace({'ROLE_': ''}) }}
                        </span>
                        <div class="flex-1 h-px bg-outline/20"></div>
                        <div class="flex items-center gap-1.5 text-[10px] font-bold {{ user.status == 'ACTIVE' ? 'text-green-500' : 'text-red-500' }}">
                            <span class="w-1.5 h-1.5 rounded-full {{ user.status == 'ACTIVE' ? 'bg-green-500' : 'bg-red-500' }}"></span>
                            {{ user.status }}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div x-show="activeTab === 'messages'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" class="space-y-6">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-2xl font-extrabold font-headline tracking-tighter">{{ 'dashboard.tabs.messages'|trans }}</h3>
            <span class="text-xs font-bold text-gray-400 bg-gray-100 px-3 py-1 rounded-full">Secure drop / Dépôt sécurisé</span>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {% for report in messagingReports %}
            <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-outline/20 group hover:shadow-md transition-all">
                <div class="flex items-start justify-between mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-red-50 text-red-500 flex items-center justify-center group-hover:rotate-12 transition-transform">
                            <span class="material-symbols-outlined">warning</span>
                        </div>
                        <div>
                            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Report #{{ report.id }}</div>
                            <div class="text-xs font-bold text-red-600 tracking-wide">{{ report.reason }}</div>
                        </div>
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-6 mb-8 p-4 bg-gray-50/50 rounded-2xl border border-outline/10">
                    <div>
                        <div class="text-[9px] font-bold text-gray-400 uppercase mb-1">{{ 'dashboard.reports.reporter'|trans }}</div>
                        <div class="flex items-center gap-2">
                            {% set rep_pfp = report.reporter_pfp %}
                            {% set rep_url = null %}
                            {% if rep_pfp %}
                                {% if rep_pfp starts with 'http' %}{% set rep_url = rep_pfp %}
                                {% elseif rep_pfp starts with '/uploads/' %}{% set rep_url = rep_pfp %}
                                {% else %}{% set rep_url = '/uploads/profiles/' ~ rep_pfp|split('\\')|last|split('/')|last %}{% endif %}
                            {% endif %}
                            <div class="w-5 h-5 rounded-full bg-gray-200 overflow-hidden flex items-center justify-center text-[8px] font-bold">
                                {% if rep_url %}<img src="{{ rep_url }}" class="w-full h-full object-cover">
                                {% else %}{{ report.reporter_first|first }}{{ report.reporter_last|first }}{% endif %}
                            </div>
                            <div class="text-sm font-extrabold">{{ report.reporter_first }} {{ report.reporter_last }}</div>
                        </div>
                    </div>
                    <div>
                        <div class="text-[9px] font-bold text-gray-400 uppercase mb-1">Target / Cible</div>
                        <div class="flex items-center gap-2">
                            {% set trg_pfp = report.reported_pfp %}
                            {% set trg_url = null %}
                            {% if trg_pfp %}
                                {% if trg_pfp starts with 'http' %}{% set trg_url = trg_pfp %}
                                {% elseif trg_pfp starts with '/uploads/' %}{% set trg_url = trg_pfp %}
                                {% else %}{% set trg_url = '/uploads/profiles/' ~ trg_pfp|split('\\')|last|split('/')|last %}{% endif %}
                            {% endif %}
                            <div class="w-5 h-5 rounded-full bg-gray-200 overflow-hidden flex items-center justify-center text-[8px] font-bold">
                                {% if trg_url %}<img src="{{ trg_url }}" class="w-full h-full object-cover">
                                {% else %}{{ report.reported_first|first }}{{ report.reported_last|first }}{% endif %}
                            </div>
                            <div class="text-sm font-extrabold">{{ report.reported_first }} {{ report.reported_last }}</div>
                        </div>
                    </div>
                </div>
                
                {% if report.details %}
                <div class="mb-8 overflow-hidden rounded-2xl relative">
                    <div class="absolute top-0 left-0 w-1 h-full bg-primary/20"></div>
                    <div class="bg-gray-50/20 p-4 text-[11px] text-on-surface-variant leading-relaxed">
                        {{ report.details }}
                    </div>
                </div>
                {% endif %}
                
                <div class="flex items-center gap-3">
                    <button @click="resolveReport({{ report.id }}, 'IGNORE')" class="flex-1 py-3.5 text-xs font-bold text-on-surface-variant bg-gray-50 border border-outline/30 rounded-2xl hover:bg-white hover:border-outline transition-all active:scale-95 uppercase tracking-wider">{{ 'dashboard.reports.dismiss'|trans }}</button>
                    <button @click="resolveReport({{ report.id }}, 'BLOCK_USER')" class="flex-2 py-3.5 px-8 text-xs font-bold text-white bg-red-500 rounded-2xl hover:bg-black transition-all active:scale-95 shadow-lg shadow-red-100 uppercase tracking-wider">{{ 'dashboard.reports.ban'|trans }}</button>
                </div>
            </div>
            {% else %}
            <div class="lg:col-span-2 bg-gray-50/50 border border-dashed border-outline/30 rounded-[3rem] p-16 text-center">
                <span class="material-symbols-outlined text-5xl text-gray-300 mb-4">check_circle</span>
                <h4 class="text-xl font-bold text-on-surface-variant mb-1">{{ 'dashboard.reports.clean_inbox'|trans }}</h4>
                <p class="text-sm text-gray-400">{{ 'dashboard.reports.no_pending'|trans }}</p>
            </div>
            {% endfor %}
        </div>
    </div>

    <div x-show="activeTab === 'community'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" class="space-y-6">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-2xl font-extrabold font-headline tracking-tighter">Community Reports / Signalements communautaires</h3>
            <span class="text-xs font-bold text-gray-400 bg-gray-100 px-3 py-1 rounded-full">{{ communityReports|length }} pending</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {% for report in communityReports %}
            <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-outline/20 group hover:shadow-md transition-all">
                <div class="flex items-start justify-between mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center group-hover:rotate-12 transition-transform">
                            <span class="material-symbols-outlined">forum</span>
                        </div>
                        <div>
                            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Community Report #{{ report.id }}</div>
                            <div class="text-xs font-bold text-amber-600 tracking-wide">{{ report.reason }}</div>
                        </div>
                    </div>
                    <div class="text-[10px] text-gray-400">{{ report.created_at|date('d M Y') }}</div>
                </div>

                {# Reporter / Reported #}
                <div class="grid grid-cols-2 gap-4 mb-5 p-4 bg-gray-50/50 rounded-2xl border border-outline/10">
                    <div>
                        <div class="text-[9px] font-bold text-gray-400 uppercase mb-1">{{ 'dashboard.reports.reporter'|trans }}</div>
                        <div class="text-sm font-extrabold">{{ report.reporter_first }} {{ report.reporter_last }}</div>
                    </div>
                    <div>
                        <div class="text-[9px] font-bold text-gray-400 uppercase mb-1">Reported user / Cible</div>
                        <div class="text-sm font-extrabold">{{ report.reported_first }} {{ report.reported_last }}</div>
                    </div>
                </div>

                {# Post snippet #}
                {% if report.post_content or report.details %}
                <div class="mb-5 rounded-2xl overflow-hidden relative">
                    <div class="absolute top-0 left-0 w-1 h-full bg-amber-400/30"></div>
                    <div class="bg-amber-50/30 p-4 text-[11px] text-on-surface-variant leading-relaxed">
                        <div class="text-[9px] font-bold text-gray-400 uppercase mb-1">{% if report.post_title %}{{ report.post_title }} &mdash; {% endif %}Post content / Contenu</div>
                        {{ (report.post_content ?? report.details)|slice(0, 200) }}{% if (report.post_content ?? report.details)|length > 200 %}…{% endif %}
                    </div>
                </div>
                {% endif %}

                <div class="flex items-center gap-2">
                    <button @click="resolveReport({{ report.id }}, 'IGNORE')"
                            class="flex-1 py-3 text-xs font-bold text-on-surface-variant bg-gray-50 border border-outline/30 rounded-2xl hover:bg-white transition-all active:scale-95 uppercase tracking-wider">
                        {{ 'dashboard.reports.dismiss'|trans }}
                    </button>
                    {% if report.post_id %}
                    <button @click="deleteCommunityPost({{ report.post_id }}, {{ report.id }})"
                            class="flex-1 py-3 text-xs font-bold text-white bg-amber-500 rounded-2xl hover:bg-amber-600 transition-all active:scale-95 shadow-md shadow-amber-100 uppercase tracking-wider">
                        {{ 'dashboard.reports.delete_post'|trans }}
                    </button>
                    {% endif %}
                    <button @click="resolveReport({{ report.id }}, 'BLOCK_USER')"
                            class="flex-1 py-3 text-xs font-bold text-white bg-red-500 rounded-2xl hover:bg-black transition-all active:scale-95 shadow-md shadow-red-100 uppercase tracking-wider">
                        {{ 'dashboard.reports.ban'|trans }}
                    </button>
                </div>
            </div>
            {% else %}
            <div class="lg:col-span-2 bg-gray-50/50 border border-dashed border-outline/30 rounded-[3rem] p-16 text-center">
                <span class="material-symbols-outlined text-5xl text-gray-300 mb-4">check_circle</span>
                <h4 class="text-xl font-bold text-on-surface-variant mb-1">{{ 'dashboard.reports.community_clean'|trans }}</h4>
                <p class="text-sm text-gray-400">{{ 'dashboard.reports.no_pending'|trans }}</p>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         CRUD TAB — User Management with input validation
         ════════════════════════════════════════════════════════════ -->
    <div x-show="activeTab === 'crud'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" class="space-y-6">

        <!-- Header row -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <h3 class="text-3xl font-extrabold font-headline tracking-tighter text-on-surface">{{ 'dashboard.users_management.title'|trans|default('User Management') }}</h3>
                <p class="text-sm text-on-surface-variant mt-1">{{ 'dashboard.users_management.subtitle'|trans|default('Create, edit and delete accounts.') }}</p>
            </div>
            <button @click="openCreate()"
                    class="flex items-center gap-2 px-6 py-3 rounded-2xl bg-amber-500 text-white text-sm font-bold shadow-lg shadow-amber-200 hover:bg-amber-600 active:scale-95 transition-all">
                <span class="material-symbols-outlined text-xl">person_add</span> {{ 'dashboard.users_management.add_user'|trans|default('Add user') }}
            </button>
        </div>

        <!-- Search & filter -->
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xl">search</span>
                <input type="text" x-model="crudSearch" placeholder="{{ 'dashboard.users_management.search'|trans|default('Search by name or email...') }}"
                       class="w-full pl-12 pr-4 py-3 rounded-2xl border border-outline/30 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 transition">
            </div>
            <select x-model="crudRoleFilter"
                    class="px-4 py-3 rounded-2xl border border-outline/30 bg-white text-sm font-bold focus:outline-none focus:ring-2 focus:ring-amber-400 transition">
                <option value="">{{ 'dashboard.users_management.all_roles'|trans|default('All roles') }}</option>
                <option value="ROLE_ADMIN">Admin</option>
                <option value="ROLE_PSYCHOLOGUE">Psychologue</option>
                <option value="ROLE_USER">User / Utilisateur</option>
            </select>
            <select x-model="crudStatusFilter"
                    class="px-4 py-3 rounded-2xl border border-outline/30 bg-white text-sm font-bold focus:outline-none focus:ring-2 focus:ring-amber-400 transition">
                <option value="">All statuses / Tous les statuts</option>
                <option value="ACTIVE">Active / Actif</option>
                <option value="BLOCKED">Blocked / Bloqué</option>
                <option value="PENDING">Pending / En attente</option>
            </select>
        </div>

        <!-- Flash / operation result banner -->
        <div x-show="crudFlash" x-transition
             :class="crudFlashType === 'success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700'"
             class="flex items-center gap-3 px-6 py-4 rounded-2xl border text-sm font-bold">
            <span class="material-symbols-outlined" x-text="crudFlashType === 'success' ? 'check_circle' : 'error'"></span>
            <span x-text="crudFlash"></span>
        </div>

        <!-- User table -->
        <div class="bg-white rounded-[2.5rem] border border-outline/20 shadow-sm overflow-hidden">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-outline/20 text-[10px] font-bold uppercase tracking-[0.12em] text-on-surface-variant">
                        <th class="text-left px-8 py-5">User / Utilisateur</th>
                        <th class="text-left px-4 py-5 hidden md:table-cell">Email</th>
                        <th class="text-left px-4 py-5 hidden lg:table-cell">Phone / Téléphone</th>
                        <th class="text-left px-4 py-5">Role / Rôle</th>
                        <th class="text-left px-4 py-5">Status / Statut</th>
                        <th class="text-right px-8 py-5">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr class="border-b border-outline/10 hover:bg-gray-50 transition-colors group"
                        x-show="crudFilter(
                            '{{ user.first_name|e('html_attr') }} {{ user.last_name|e('html_attr') }} {{ user.email|e('html_attr') }}',
                            '{{ user.roles|json_encode|e('html_attr') }}',
                            '{{ user.status|e('html_attr') }}'
                        )">
                        <td class="px-8 py-5">
                            <div class="flex items-center gap-3">
                                {% set pfp = user.profile_picture %}
                                {% set pfp_url = null %}
                                {% if pfp %}
                                    {% if pfp starts with 'http' %}{% set pfp_url = pfp %}
                                    {% elseif pfp starts with '/uploads/' %}{% set pfp_url = pfp %}
                                    {% else %}{% set pfp_url = '/uploads/profiles/' ~ pfp|split('\\')|last|split('/')|last %}{% endif %}
                                {% endif %}
                                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm overflow-hidden shrink-0">
                                    {% if pfp_url %}
                                        <img src="{{ pfp_url }}" alt="" class="w-full h-full object-cover">
                                    {% else %}
                                        {{ user.first_name|first|upper }}{{ user.last_name|first|upper }}
                                    {% endif %}
                                </div>
                                <div class="leading-tight">
                                    <div class="font-bold text-on-surface">{{ user.first_name }} {{ user.last_name }}</div>
                                    <div class="text-[10px] text-on-surface-variant md:hidden">{{ user.email }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-5 text-on-surface-variant hidden md:table-cell text-xs">{{ user.email }}</td>
                        <td class="px-4 py-5 text-on-surface-variant hidden lg:table-cell text-xs">{{ user.phone_number ?? '—' }}</td>
                        <td class="px-4 py-5">
                            {% set roleRaw = user.roles|json_encode %}
                            <span class="px-3 py-1 rounded-full text-[9px] font-extrabold uppercase tracking-wider
                                {% if 'ROLE_ADMIN' in roleRaw %} bg-purple-100 text-purple-700
                                {% elseif 'ROLE_PSYCHOLOGUE' in roleRaw %} bg-indigo-100 text-indigo-700
                                {% else %} bg-slate-100 text-slate-600
                                {% endif %}">
                                {% if 'ROLE_ADMIN' in roleRaw %}Admin
                                {% elseif 'ROLE_PSYCHOLOGUE' in roleRaw %}Psychologist / Psychologue
                                {% else %}User / Utilisateur{% endif %}
                            </span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="flex items-center gap-1.5 text-[10px] font-bold
                                {{ user.status == 'ACTIVE' ? 'text-green-600' : (user.status == 'BLOCKED' ? 'text-red-500' : 'text-amber-600') }}">
                                <span class="w-1.5 h-1.5 rounded-full
                                    {{ user.status == 'ACTIVE' ? 'bg-green-500' : (user.status == 'BLOCKED' ? 'bg-red-500' : 'bg-amber-400') }}"></span>
                                {{ user.status }}
                            </span>
                        </td>
                        <td class="px-8 py-5">
                            <div class="flex justify-end gap-2 opacity-70 group-hover:opacity-100 transition-opacity">
                                <button @click="openEdit({{ user.id }})"
                                        title="Edit / Modifier"
                                        class="p-2.5 rounded-xl bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors active:scale-90">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </button>
                                <button @click="confirmDelete({{ user.id }}, '{{ user.first_name|e('html_attr') }} {{ user.last_name|e('html_attr') }}')"
                                        title="{{ 'dashboard.reports.delete_post'|trans }}"
                                        {% if 'ROLE_ADMIN' in user.roles|json_encode %}disabled{% endif %}
                                        class="p-2.5 rounded-xl bg-red-50 text-red-500 hover:bg-red-100 transition-colors active:scale-90 disabled:opacity-30 disabled:cursor-not-allowed">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>


        <!-- ═══ CREATE / EDIT MODAL ═══ -->
        <div x-show="modal.open" x-transition:enter="ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:leave="ease-in duration-150"
             class="fixed inset-0 z-50 flex items-center justify-center p-4"
             @mousedown.self="modal.open = false">
            <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" @click="modal.open = false"></div>

            <div class="relative bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg p-8 z-10"
                 @mousedown.stop>
                <div class="flex items-center justify-between mb-8">
                    <h4 class="text-xl font-extrabold font-headline" x-text="modal.editing ? 'Edit user / Modifier l\'utilisateur' : 'Create user / Créer un utilisateur'"></h4>
                    <button @click="modal.open = false" class="p-2 rounded-xl hover:bg-gray-100 transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <form @submit.prevent="submitForm()" novalidate class="space-y-5">

                    <!-- First & Last name -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">First Name / Prénom *</label>
                            <input type="text" x-model="modal.form.firstName" id="crud_firstName" minlength="2" required
                                   :class="modal.errors.firstName ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                                   class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition" placeholder="Prénom">
                            <div x-show="modal.errors.firstName" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.firstName"></div>
                        </div>
                        <div>
                            <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">Last Name / Nom *</label>
                            <input type="text" x-model="modal.form.lastName" id="crud_lastName" minlength="2" required
                                   :class="modal.errors.lastName ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                                   class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition" placeholder="Nom">
                            <div x-show="modal.errors.lastName" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.lastName"></div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">Email *</label>
                        <input type="email" x-model="modal.form.email" id="crud_email" required
                               :class="modal.errors.email ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                               class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition" placeholder="utilisateur@exemple.com">
                        <div x-show="modal.errors.email" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.email"></div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">
                            Password / Mot de passe <span x-show="modal.editing" class="font-normal normal-case text-gray-400">(leave blank to keep current / laisser vide pour ne pas changer)</span>
                            <span x-show="!modal.editing">*</span>
                        </label>
                        <div class="relative">
                            <input :type="showPwd ? 'text' : 'password'" x-model="modal.form.password" id="crud_password"
                                   :required="!modal.editing" minlength="8"
                                   :class="modal.errors.password ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                                   class="w-full px-4 py-3 pr-12 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition" placeholder="Min. 8 characters / 8 caractères">
                            <button type="button" @click="showPwd = !showPwd"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <span class="material-symbols-outlined text-xl" x-text="showPwd ? 'visibility_off' : 'visibility'"></span>
                            </button>
                        </div>
                        <div x-show="modal.errors.password" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.password"></div>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">Phone / Téléphone</label>
                        <input type="tel" x-model="modal.form.phone" id="crud_phone"
                               pattern="[+]?[0-9 \-().]{6,20}"
                               :class="modal.errors.phone ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                               class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition" placeholder="+33 6 12 34 56 78">
                        <div x-show="modal.errors.phone" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.phone"></div>
                    </div>

                    <!-- Role & Status -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">Role / Rôle *</label>
                            <select x-model="modal.form.role" id="crud_role" required
                                    :class="modal.errors.role ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                                    class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition">
                                <option value="ROLE_USER">User / Utilisateur</option>
                                <option value="ROLE_PSYCHOLOGUE">Psychologist / Psychologue</option>
                                <option value="ROLE_ADMIN">Admin</option>
                            </select>
                            <div x-show="modal.errors.role" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.role"></div>
                        </div>
                        <div x-show="modal.editing">
                            <label class="text-[10px] font-extrabold uppercase tracking-widest text-on-surface-variant mb-1 block">Status / Statut *</label>
                            <select x-model="modal.form.status" id="crud_status"
                                    :class="modal.errors.status ? 'border-red-400 ring-1 ring-red-300' : 'border-outline/30 focus:ring-amber-400'"
                                    class="w-full px-4 py-3 rounded-xl border bg-gray-50 text-sm focus:outline-none focus:ring-2 transition">
                                <option value="ACTIVE">Active / Actif</option>
                                <option value="BLOCKED">Blocked / Bloqué</option>
                                <option value="PENDING">Pending / En attente</option>
                            </select>
                            <div x-show="modal.errors.status" class="text-[10px] text-red-500 mt-1 font-semibold" x-text="modal.errors.status"></div>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="flex gap-3 pt-2">
                        <button type="button" @click="modal.open = false"
                                class="flex-1 py-3.5 rounded-2xl border border-outline/40 text-sm font-bold text-on-surface-variant hover:bg-gray-50 transition-colors">Cancel / Annuler</button>
                        <button type="submit"
                                :disabled="modal.loading"
                                class="flex-2 px-8 py-3.5 rounded-2xl bg-amber-500 text-white text-sm font-bold shadow-lg shadow-amber-200 hover:bg-amber-600 active:scale-95 transition-all disabled:opacity-60 flex items-center gap-2">
                            <span x-show="modal.loading" class="material-symbols-outlined animate-spin text-xl">progress_activity</span>
                            <span x-text="modal.editing ? 'Save / Enregistrer' : 'Create / Créer'"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ═══ DELETE CONFIRM MODAL ═══ -->
        <div x-show="deleteModal.open" x-transition:enter="ease-out duration-200" x-transition:enter-start="opacity-0"
             class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" @click="deleteModal.open = false"></div>
            <div class="relative bg-white rounded-[2.5rem] shadow-2xl w-full max-w-sm p-8 z-10 text-center">
                <div class="w-16 h-16 rounded-full bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-5">
                    <span class="material-symbols-outlined text-4xl">delete_forever</span>
                </div>
                <h4 class="text-xl font-extrabold font-headline mb-2">Delete this account? / Supprimer ce compte ?</h4>
                <p class="text-sm text-on-surface-variant mb-8">User <strong x-text="deleteModal.name"></strong> will be permanently removed. This action is irreversible. / L'utilisateur <strong x-text="deleteModal.name"></strong> sera définitivement supprimé. Cette action est irréversible.</p>
                <div class="flex gap-3">
                    <button @click="deleteModal.open = false"
                            class="flex-1 py-3.5 rounded-2xl border border-outline/40 text-sm font-bold text-on-surface-variant hover:bg-gray-50 transition-colors">Annuler</button>
                    <button @click="executeDelete()"
                            :disabled="deleteModal.loading"
                            class="flex-1 py-3.5 rounded-2xl bg-red-500 text-white text-sm font-bold hover:bg-red-600 active:scale-95 transition-all disabled:opacity-60">
                        <span x-show="deleteModal.loading" class="material-symbols-outlined animate-spin text-xl">progress_activity</span>
                        <span x-show="!deleteModal.loading">Supprimer</span>
                    </button>
                </div>
            </div>
        </div>

    </div><!-- end crud tab -->
</div>

<script>
function adminSystem() {
    return {
        activeTab: 'overview',

        // ── Existing actions ──────────────────────────────────────
        async blockUser(userId) {
            if (!confirm('Changer le statut de cet utilisateur ?')) return;
            const res = await fetch(`/admin/users/block/${userId}`, { method: 'POST' });
            if (await res.json()) window.location.reload();
        },
        async resolveReport(reportId, action) {
            if (!confirm(`Action : ${action} ?`)) return;
            const res = await fetch(`/admin/reports/${reportId}/resolve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
            });
            if (await res.json()) window.location.reload();
        },

        // ── CRUD tab state ────────────────────────────────────────
        crudSearch: '',
        crudRoleFilter: '',
        crudStatusFilter: '',
        crudFlash: '',
        crudFlashType: 'success',
        showPwd: false,

        modal: {
            open: false,
            editing: false,
            loading: false,
            userId: null,
            errors: {},
            form: { firstName: '', lastName: '', email: '', password: '', phone: '', role: 'ROLE_USER', status: 'ACTIVE' }
        },

        deleteModal: {
            open: false,
            loading: false,
            userId: null,
            name: ''
        },

        // ── Filter helper (called per row in the table) ───────────
        crudFilter(text, rolesJson, status) {
            const search = this.crudSearch.toLowerCase();
            if (search && !text.toLowerCase().includes(search)) return false;
            if (this.crudRoleFilter && !rolesJson.includes(this.crudRoleFilter)) return false;
            if (this.crudStatusFilter && status !== this.crudStatusFilter) return false;
            return true;
        },

        // ── Flash helper ─────────────────────────────────────────
        flashMsg(msg, type = 'success') {
            this.crudFlash = msg;
            this.crudFlashType = type;
            setTimeout(() => this.crudFlash = '', 4000);
        },

        // ── Open create modal ─────────────────────────────────────
        openCreate() {
            this.modal.editing = false;
            this.modal.userId = null;
            this.modal.errors = {};
            this.modal.form = { firstName: '', lastName: '', email: '', password: '', phone: '', role: 'ROLE_USER', status: 'ACTIVE' };
            this.showPwd = false;
            this.modal.open = true;
        },

        // ── Open edit modal (loads user data first) ───────────────
        async openEdit(userId) {
            this.modal.loading = true;
            this.modal.errors = {};
            this.modal.open = true;
            this.modal.editing = true;
            this.modal.userId = userId;
            this.showPwd = false;

            try {
                const res = await fetch(`/admin/users/${userId}`, { headers: { 'Accept': 'application/json' } });
                const data = await res.json();
                this.modal.form = {
                    firstName: data.firstName || '',
                    lastName:  data.lastName  || '',
                    email:     data.email     || '',
                    password:  '',
                    phone:     data.phone     || '',
                    role:      data.role      || 'ROLE_USER',
                    status:    data.status    || 'ACTIVE'
                };
            } catch (e) {
                this.flashMsg('Erreur lors du chargement.', 'error');
                this.modal.open = false;
            } finally {
                this.modal.loading = false;
            }
        },

        // ── Submit create / edit ──────────────────────────────────
        async submitForm() {
            this.modal.loading = true;
            this.modal.errors = {};

            const url = this.modal.editing
                ? `/admin/users/${this.modal.userId}/edit`
                : `/admin/users`;

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(this.modal.form)
                });
                const data = await res.json();

                if (res.status === 422) {
                    this.modal.errors = data.errors || {};
                } else if (data.success) {
                    this.modal.open = false;
                    this.flashMsg(this.modal.editing ? 'Utilisateur mis à jour.' : 'Utilisateur créé avec succès.');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    this.flashMsg(data.error || 'Une erreur est survenue.', 'error');
                }
            } catch (e) {
                this.flashMsg('Erreur réseau.', 'error');
            } finally {
                this.modal.loading = false;
            }
        },

        // ── Confirm delete ────────────────────────────────────────
        confirmDelete(userId, name) {
            this.deleteModal.userId = userId;
            this.deleteModal.name = name;
            this.deleteModal.loading = false;
            this.deleteModal.open = true;
        },

        // ── Execute delete ────────────────────────────────────────
        async executeDelete() {
            this.deleteModal.loading = true;
            try {
                const res = await fetch(`/admin/users/${this.deleteModal.userId}/delete`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    this.deleteModal.open = false;
                    this.flashMsg('Utilisateur supprimé.');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    this.deleteModal.open = false;
                    this.flashMsg(data.error || 'Suppression impossible.', 'error');
                }
            } catch (e) {
                this.flashMsg('Erreur réseau.', 'error');
            } finally {
                this.deleteModal.loading = false;
            }
        },

        // ── Resolve Report ──────────────────────────────────────────
        async resolveReport(reportId, action) {
            if (!confirm('Êtes-vous sûr de vouloir effectuer cette action sur ce signalement ?')) return;
            try {
                const res = await fetch(`/admin/reports/${reportId}/resolve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ action: action })
                });
                const data = await res.json();
                if (data.success) {
                    this.flashMsg('Signalement traité.');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    this.flashMsg(data.error || 'Erreur lors du traitement.', 'error');
                }
            } catch (e) {
                this.flashMsg('Erreur réseau.', 'error');
            }
        },

        // ── Delete a community post and resolve the associated report ─────
        async deleteCommunityPost(postId, reportId) {
            if (!confirm('Delete this post and resolve the report? / Supprimer ce post et clôturer le signalement ?')) return;
            try {
                // 1. Delete the post
                const delRes = await fetch(`/admin/community/post/${postId}/delete`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const delData = await delRes.json();
                if (!delData.success) {
                    this.flashMsg(delData.error || 'Could not delete post.', 'error');
                    return;
                }
                // 2. Resolve the report as IGNORE (post is gone, no further action needed)
                await fetch(`/admin/reports/${reportId}/resolve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ action: 'IGNORE' })
                });
                this.flashMsg('Post deleted and report resolved. / Post supprimé et signalement clôturé.');
                setTimeout(() => window.location.reload(), 1200);
            } catch (e) {
                this.flashMsg('Network error / Erreur réseau.', 'error');
            }
        }
    }
}
</script>
{% endblock %}
