{% extends 'layouts/dashboard.html.twig' %}

{% block header_title %}Tableau de bord Client{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Welcome section -->
    <div class="bg-white rounded-[2rem] p-8 lg:p-12 shadow-[0_32px_64px_-16px_rgba(0,104,118,0.08)] border border-white relative overflow-hidden">
        <div class="absolute right-0 top-0 w-1/2 h-full bg-gradient-to-l from-[#e5f7f6] to-transparent opacity-50"></div>
        <div class="relative z-10 w-full md:w-2/3">
            <h2 class="text-4xl font-bold text-[#0e1e1e] mb-4 tracking-tight">Bonjour, {{ app.user.firstName }} !</h2>
            <p class="text-lg text-[#3c494c] mb-8 font-medium">Prêt à continuer votre voyage vers le bien-être aujourd'hui ? La régularité est la clé de la sérénité.</p>
            
            <div class="flex gap-4">
                <a href="{{ path('app_map') }}" class="px-6 py-3 rounded-xl bg-gradient-to-r from-[#006876] to-[#00BCD4] text-white font-semibold shadow-[0_8px_24px_-8px_rgba(0,188,212,0.5)] hover:shadow-[0_12px_28px_-6px_rgba(0,188,212,0.6)] transition-all">
                    Trouver un Thérapeute
                </a>
                <a href="{{ path('app_messages') }}" class="px-6 py-3 rounded-xl bg-[#e5f7f6] text-[#006876] font-semibold hover:bg-[#dff1f0] transition-colors">
                    Mes Messages
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Conversations Card -->
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative overflow-hidden group">
            <div class="absolute left-0 top-0 h-full w-2 bg-gradient-to-b from-[#00bcd4] to-[#006876]"></div>
            <div class="pl-4">
                <h3 class="text-[#3c494c] text-sm font-semibold uppercase tracking-wider mb-2">Thérapeutes Actifs</h3>
                <div class="flex items-end gap-3">
                    <span class="text-4xl font-bold text-[#0e1e1e]">{{ conversationCount }}</span>
                </div>
            </div>
        </div>

        <!-- Notifications Card -->
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative overflow-hidden group">
            <div class="absolute left-0 top-0 h-full w-2 bg-gradient-to-b from-[#f19640] to-[#8f4e00]"></div>
            <div class="pl-4">
                <h3 class="text-[#3c494c] text-sm font-semibold uppercase tracking-wider mb-2">Notifications Non Lues</h3>
                <div class="flex items-end gap-3">
                    <span class="text-4xl font-bold text-[#0e1e1e]">{{ unreadNotifs }}</span>
                </div>
            </div>
        </div>

        <!-- Messages Card -->
        <div class="bg-white rounded-[1.5rem] p-6 shadow-sm border border-[#e5f7f6] relative overflow-hidden group">
            <div class="absolute left-0 top-0 h-full w-2 bg-gradient-to-b from-[#10B981] to-[#006c49]"></div>
            <div class="pl-4">
                <h3 class="text-[#3c494c] text-sm font-semibold uppercase tracking-wider mb-2">Messages en attente</h3>
                <div class="flex items-end gap-3">
                    <span class="text-4xl font-bold text-[#0e1e1e]">{{ unreadMessages }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Inspiration -->
    <div class="bg-gradient-to-br from-[#d4e6e5] to-[#ebfdfc] rounded-[2rem] p-8 shadow-sm">
        <h3 class="text-[#006876] font-bold text-xl mb-4">La pensée du jour</h3>
        <p class="text-[#0e1e1e] text-2xl font-serif italic mb-6">"Prenez le temps d'apprécier ce qui vous rend différent, car c'est là que réside votre véritable force."</p>
        <p class="text-[#3c494c] font-medium">— Une note de l'équipe InnerTrack</p>
    </div>

</div>
{% endblock %}
