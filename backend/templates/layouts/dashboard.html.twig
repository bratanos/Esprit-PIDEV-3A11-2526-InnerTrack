{% extends 'base.html.twig' %}

{% block head %}
    {{ parent() }}
    <!-- Stitch AI Dashboard Config & Fonts -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4f46e5",
                        "secondary": "#0d9488",
                        "surface": "#fcfcfd",
                        "surface-container": "#f3f4f6",
                        "on-surface": "#111827",
                        "on-surface-variant": "#4b5563",
                        "outline": "#e5e7eb",
                        "primary-container": "#e0e7ff",
                        "secondary-container": "#ccfbf1"
                    },
                    fontFamily: {
                        "headline": ["Manrope", "sans-serif"],
                        "body": ["Inter", "sans-serif"],
                        "label": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "none": "0",
                        "sm": "0.125rem",
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "2xl": "2rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .serene-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        }
        .soft-elevation {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 10px -2px rgba(0, 0, 0, 0.03);
        }
    </style>
{% endblock %}

{% block layout %}
<div class="bg-surface font-body text-on-surface antialiased flex w-full h-screen overflow-hidden">
    <!-- Navigation Sidebar -->
    <aside class="w-72 hidden md:flex flex-shrink-0 flex-col py-10 px-6 border-r border-outline bg-white z-50 h-full overflow-y-auto">
        <div class="mb-14 px-2">
            <h1 class="text-2xl font-extrabold text-primary tracking-tight font-headline">InnerTrack</h1>
            <p class="text-[10px] text-on-surface-variant font-bold tracking-[0.2em] uppercase mt-1">Digital Sanctuary</p>
        </div>
        
        <nav class="flex-1 space-y-2">
            {{ _self.nav_link(path('app_dashboard'), 'Dashboard', 'dashboard', app.request.get('_route') == 'app_dashboard') }}
            {{ _self.nav_link(path('app_map'), 'Find Therapist', 'psychology', app.request.get('_route') == 'app_map') }}
            {{ _self.nav_link(path('app_messages'), 'Messages', 'chat_bubble', app.request.get('_route') == 'app_messages') }}
            {{ _self.nav_link(path('app_notifications'), 'Notifications', 'notifications', app.request.get('_route') == 'app_notifications') }}
            {{ _self.nav_link(path('app_profile'), 'Profile', 'person', app.request.get('_route') == 'app_profile') }}
            {{ _self.nav_link(path('app_settings'), 'Settings', 'settings', app.request.get('_route') == 'app_settings') }}
            {% if 'ROLE_ADMIN' in app.user.roles %}
                {{ _self.nav_link(path('admin_user_block', {'id': 1})|split('/users')[0], 'Administration', 'admin_panel_settings', false) }}
            {% endif %}
        </nav>
        
        <div class="mt-8 space-y-4">
            <button class="w-full bg-primary text-white py-4 rounded-xl font-bold text-sm tracking-wide shadow-lg shadow-primary/25 hover:brightness-110 active:scale-[0.98] transition-all">
                Book Session
            </button>
            <a href="{{ path('app_logout') }}" class="w-full text-on-surface-variant hover:bg-red-50 hover:text-red-500 py-3 rounded-xl font-bold text-sm tracking-wide transition-all flex items-center gap-3 justify-center">
                <span class="material-symbols-outlined text-[20px]" data-icon="logout">logout</span> Log Out
            </a>
        </div>
    </aside>

    <!-- Main Content Canvas -->
    <div class="flex-1 flex flex-col relative w-full h-full bg-surface">
        <!-- Top Navigation Bar -->
        <header class="flex-shrink-0 flex justify-between items-center h-20 px-6 lg:px-12 bg-white/80 backdrop-blur-md border-b border-outline/50 z-40">
            <div class="flex items-center gap-4 bg-gray-100/80 px-4 lg:px-6 py-2.5 rounded-full w-full max-w-[440px] border border-transparent focus-within:border-primary/20 transition-all">
                <span class="material-symbols-outlined text-gray-400 text-xl" data-icon="search">search</span>
                <input type="text" placeholder="Search sessions, resources..." class="bg-transparent border-none focus:ring-0 text-sm w-full placeholder:text-gray-500 font-medium outline-none"/>
            </div>
            
            <div class="flex items-center gap-4 lg:gap-8 ml-4">
                <div class="hidden lg:flex gap-4">
                    <button class="p-2 rounded-full text-on-surface-variant hover:bg-gray-100 transition-colors">
                        <span class="material-symbols-outlined" data-icon="help">help</span>
                    </button>
                    <button class="p-2 rounded-full text-on-surface-variant hover:bg-gray-100 transition-colors">
                        <span class="material-symbols-outlined" data-icon="dark_mode">dark_mode</span>
                    </button>
                </div>
                <div class="hidden lg:block h-8 w-px bg-outline"></div>
                
                <a href="{{ path('app_profile') }}" class="flex items-center gap-4 group cursor-pointer">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-bold text-on-surface leading-none">{{ app.user.fullName }}</p>
                        <p class="text-[10px] text-secondary font-bold uppercase tracking-wider mt-1">{{ app.user.primaryRole|replace({'ROLE_': ''})|lower|capitalize }}</p>
                    </div>
                    <div class="w-10 h-10 lg:w-12 lg:h-12 rounded-2xl bg-primary text-white flex items-center justify-center font-bold text-lg ring-2 ring-offset-2 ring-transparent group-hover:ring-primary/20 transition-all">
                        {{ app.user.firstName|first|default('U')|upper }}{{ app.user.lastName|first|default('')|upper }}
                    </div>
                </a>
            </div>
        </header>

        <!-- Main Workspace (scrollable) -->
        <div class="flex-1 overflow-y-auto">
            <div class="p-6 lg:p-12 max-w-7xl mx-auto w-full relative">
                {% include 'components/_flash_messages.html.twig' %}
                {% block content %}{% endblock %}
            </div>

            <!-- Footer -->
            <footer class="px-8 lg:px-12 py-8 border-t border-outline flex flex-col md:flex-row justify-between items-center gap-6 bg-white shrink-0">
                <div class="flex gap-10">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Global Status</span>
                        <span class="text-sm font-bold text-green-600 flex items-center gap-2 mt-1">
                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span> Systems Active
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Next Session</span>
                        <span class="text-sm font-bold text-on-surface mt-1">N/A</span>
                    </div>
                </div>
                <div class="flex items-center gap-6">
                    <a href="#" class="text-xs font-bold text-gray-400 hover:text-primary transition-colors">Privacy</a>
                    <a href="#" class="text-xs font-bold text-gray-400 hover:text-primary transition-colors">Support</a>
                    <span class="text-xs font-medium text-gray-300">© 2024 InnerTrack AI</span>
                </div>
            </footer>
        </div>
    </div>
</div>

{% macro nav_link(url, text, icon, active) %}
    <a href="{{ url }}" class="flex items-center gap-4 px-4 lg:px-5 py-3 rounded-xl transition-all font-medium {{ active ? 'bg-primary text-white font-semibold shadow-md shadow-primary/20' : 'text-on-surface-variant hover:bg-gray-50 hover:text-primary' }}">
        <span class="material-symbols-outlined text-xl" data-icon="{{ icon }}">{{ icon }}</span>
        <span class="text-sm">{{ text }}</span>
    </a>
{% endmacro %}
{% endblock %}
