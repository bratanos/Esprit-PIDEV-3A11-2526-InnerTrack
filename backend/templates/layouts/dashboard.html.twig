{% extends 'base.html.twig' %}

{% block body %}
<div class="flex h-screen bg-[#ebfdfc] overflow-hidden font-['Inter']">
    
    <!-- Sidebar -->
    <aside class="w-72 bg-white/80 backdrop-blur-xl border-r border-[#d4e6e5] flex flex-col justify-between hidden md:flex transition-all duration-300">
        <div>
            <!-- Header/Logo area -->
            <div class="h-20 flex items-center px-8 border-b border-[#d4e6e5]/50">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3">
                    <img src="{{ asset('images/innertracklogo1.png') }}" alt="Logo" class="w-8 h-8 rounded-xl" />
                    <span class="text-xl font-bold text-[#006876] tracking-tight">InnerTrack</span>
                </a>
            </div>

            <!-- User Profile Area -->
            <div class="px-8 mt-8 mb-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#00bcd4] to-[#006876] flex items-center justify-center text-white font-semibold text-lg shadow-sm">
                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                    </div>
                    <div>
                        <h3 class="text-[#0e1e1e] font-semibold truncate max-w-[140px]">{{ app.user.fullName }}</h3>
                        <p class="text-[0.7rem] uppercase tracking-wider text-[#3c494c] font-semibold">{{ app.user.primaryRole|replace({'ROLE_': ''})|lower|capitalize }}</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="px-4 space-y-2 mt-4">
                {{ _self.nav_link(path('app_dashboard'), 'Tableau de bord', 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z', app.request.get('_route') == 'app_dashboard') }}
                {{ _self.nav_link(path('app_messages'), 'Messages', 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z', app.request.get('_route') == 'app_messages') }}
                {{ _self.nav_link(path('app_map'), 'Carte des thérapeutes', 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z', app.request.get('_route') == 'app_map') }}
                {{ _self.nav_link(path('app_profile'), 'Mon Profil', 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z', app.request.get('_route') == 'app_profile') }}
                {{ _self.nav_link(path('app_settings'), 'Paramètres', 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z', app.request.get('_route') == 'app_settings') }}
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    {{ _self.nav_link(path('admin_user_block', {'id': 1})|split('/users')[0], 'Administration', 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', false) }}
                {% endif %}
            </nav>
        </div>

        <div class="px-4 pb-8">
            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-[#3c494c] hover:bg-white hover:text-[#006876] transition-all duration-200">
                <svg class="w-5 h-5 mb-[1px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span class="font-medium">Déconnexion</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col relative overflow-hidden">
        <!-- Header -->
        <header class="h-20 flex items-center justify-between px-8 bg-white/40 backdrop-blur-md z-10">
            <h1 class="text-2xl font-bold text-[#0e1e1e] tracking-tight">{% block header_title %}Vue d'ensemble{% endblock %}</h1>
            <div class="flex items-center gap-4">
                <!-- Notifications -->
                <a href="{{ path('app_notifications') }}" class="relative w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#3c494c] hover:text-[#00BCD4] shadow-sm hover:shadow-md transition-all">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    <span class="absolute top-3 right-3 w-2 h-2 bg-red-500 rounded-full"></span>
                </a>
            </div>
        </header>

        <!-- Dynamic Content -->
        <div class="flex-1 overflow-y-auto px-8 py-8 relative">
            {% block content %}{% endblock %}
        </div>
    </main>

</div>

{% macro nav_link(url, text, icon, active) %}
<a href="{{ url }}" class="flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 {{ active ? 'bg-[#00BCD4]/10 text-[#006876] font-semibold' : 'text-[#3c494c] hover:bg-white hover:text-[#00BCD4] font-medium' }}">
    <svg class="w-5 h-5 mb-[1px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ icon }}"></path></svg>
    <span>{{ text }}</span>
</a>
{% endmacro %}
{% endblock %}
