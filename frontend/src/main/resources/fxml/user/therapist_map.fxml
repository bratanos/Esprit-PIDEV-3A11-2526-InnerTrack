<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import com.sothawo.mapjfx.MapView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.user.TherapistMapController"
            stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css, @../../styles/base/typography.css, @../../styles/base/controls.css, @../../styles/themes/theme-light.css, @../../styles/views/dashboard.css">

    <!-- Top Bar -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 12 20; -fx-background-color: white;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <Button onAction="#handleBack"
                    style="-fx-background-color: #f1f1f1; -fx-background-radius: 50;
                           -fx-padding: 6.4; -fx-cursor: hand;">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#2c3e50"/>
                </graphic>
            </Button>
            <VBox spacing="1.6">
                <Label text="%user.map.title"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="%user.map.subtitle"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 10.4px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Legend -->
            <HBox spacing="6.4" alignment="CENTER"
                  style="-fx-background-color: #FFF0F5; -fx-padding: 6.4 11.2;
                         -fx-background-radius: 20;">
                <Label text="●" style="-fx-text-fill: #FF69B4; -fx-font-size: 14.4px;"/>
                <Label text="%user.map.legend"
                       style="-fx-text-fill: #C2185B; -fx-font-size: 10.4px;"/>
            </HBox>
        </HBox>
    </top>

    <!-- Full-screen map -->
    <center>
        <StackPane>
            <MapView fx:id="mapView"/>

            <!-- Floating info card -->
            <VBox fx:id="infoCard"
                  spacing="8"
                  prefWidth="272"
                  maxWidth="272"
                  StackPane.alignment="TOP_RIGHT"
                  style="-fx-padding: 12.8; -fx-background-color: rgba(255,255,255,0.96); -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #FF69B4; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 18, 0, 0, 6); -fx-translate-x: -16; -fx-translate-y: 16;">
                <Label text="%user.map.therapist"
                       style="-fx-font-size: 11.2px; -fx-font-weight: 800; -fx-text-fill: #2c3e50;"/>

                <Label fx:id="nameLabel" text="" wrapText="true"
                       style="-fx-font-size: 14.4px; -fx-font-weight: 800; -fx-text-fill: #2c3e50;"/>

                <Label fx:id="specializationLabel" text="" wrapText="true"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 10.4px;"/>

                <Label fx:id="addressLabel" text="" wrapText="true"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 10.4px;"/>

                <Separator/>

                <Label text="%user.map.bio" style="-fx-font-size: 10.4px; -fx-font-weight: 800; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="bioLabel" text="" wrapText="true"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 10.4px;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="contactButton" text="%user.map.contactBtn" onAction="#handleContact"
                        style="-fx-background-color: #FF69B4; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 8 12.8; -fx-cursor: hand;"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
