<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.user.UserDashboardController"
            stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css,
                         @../../styles/base/typography.css, @../../styles/base/controls.css,
                         @../../styles/themes/theme-light.css, @../../styles/components/sidebar.css,
                         @../../styles/views/dashboard.css"
            styleClass="dashboard-view"
            maxHeight="Infinity" maxWidth="Infinity">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280">
            <VBox styleClass="sidebar-logo" alignment="CENTER">
                <ImageView fitWidth="150" preserveRatio="true">
                    <image><Image url="@../../images/innertracklogo1.png"/></image>
                </ImageView>
            </VBox>

            <VBox styleClass="profile-section">
                <javafx.scene.shape.Circle fx:id="profileCircle" radius="35" styleClass="profile-pic"/>
                <Label fx:id="userFullNameLabel" text="Utilisateur" styleClass="profile-name"/>
            </VBox>

            <Separator opacity="0.1"/>

            <VBox spacing="5">
                <Button text="%sidebar.user.dashboard"
                        styleClass="sidebar-button, sidebar-button-active" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-th-large" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.user.journal" styleClass="sidebar-button" maxWidth="Infinity"
                        onAction="#handleGoToJournal">
                    <graphic><FontIcon iconLiteral="fas-book" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.user.habits" styleClass="sidebar-button" maxWidth="Infinity"
                        onAction="#handleGoToHabits">
                    <graphic><FontIcon iconLiteral="fas-check-circle" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.user.map" onAction="#handleGoToMap"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-map-marker-alt" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.messages" onAction="#handleGoToMessages"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-comments" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="🧪 Psy Tests" onAction="#handleGoToTests"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-brain" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="🗣️ Community" onAction="#handleGoToCommunity"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.profile" onAction="#handleGoToProfile"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-user" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
                <Button text="%sidebar.settings" onAction="#handleGoToSettings"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-cog" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="%sidebar.logout" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleLogout">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="18" iconColor="#ffffff"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="30" styleClass="dashboard-container" VBox.vgrow="ALWAYS">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <!-- Header -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox>
                        <Label fx:id="welcomeLabel"
                               styleClass="dashboard-header-label"
                               text="%dashboard.user.welcome"/>
                        <Label text="%dashboard.user.title"
                               styleClass="dashboard-subtitle-label"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Accepted request notification -->
                    <HBox fx:id="acceptedAlert" spacing="8" alignment="CENTER"
                          visible="false" managed="false"
                          styleClass="alert-success-punchy"
                          onMouseClicked="#handleGoToMessages">
                        <FontIcon iconLiteral="fas-check-circle" iconSize="16" iconColor="white"/>
                        <Label fx:id="acceptedAlertLabel" text=""
                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </HBox>

                <!-- Stats Cards -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-fire" iconSize="24" iconColor="#e67e22"/>
                        <Label fx:id="streakLabel" styleClass="stat-value" text="0"
                               style="-fx-text-fill: #e67e22;"/>
                        <Label styleClass="stat-label" text="%dashboard.user.streak"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-pen-nib" iconSize="24" iconColor="#1d7bed"/>
                        <Label fx:id="journalEntriesLabel" styleClass="stat-value" text="0"/>
                        <Label styleClass="stat-label" text="%dashboard.user.entries"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-check-double" iconSize="24" iconColor="#27ae60"/>
                        <Label fx:id="habitsCompletedLabel" styleClass="stat-value" text="0%"
                               style="-fx-text-fill: #27ae60;"/>
                        <Label styleClass="stat-label" text="%dashboard.user.habits"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-comments" iconSize="24" iconColor="#FF69B4"/>
                        <Label fx:id="activeConvLabel" styleClass="stat-value" text="0"
                               style="-fx-text-fill: #FF69B4;"/>
                        <Label styleClass="stat-label" text="%dashboard.user.activeConv"/>
                    </VBox>
                </HBox>

                <!-- Daily Inspiration -->
                <VBox styleClass="dashboard-quote-card" spacing="15">
                    <Label text="%dashboard.user.inspiration" styleClass="quote-header"/>
                    <Label fx:id="quoteTextLabel" text="%dashboard.user.quote" styleClass="quote-text" wrapText="true"/>
                    <Label fx:id="quoteAuthorLabel" text="%dashboard.user.quoteAuthor" styleClass="quote-author"/>
                </VBox>

                <!-- Quick Actions & Summaries -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="10">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="My Latest Activities" style="-fx-font-weight: bold;"/>
                        
                        <Label fx:id="derniereEntreeLabel" text="Latest journal entry: None" style="-fx-text-fill: #4a5568; -fx-padding: 5 0;"/>
                        <Label fx:id="nombreHabitudesLabel" text="Active habits: 0" style="-fx-text-fill: #4a5568; -fx-padding: 5 0;"/>
                        <Label fx:id="moyenneHumeurLabel" text="Average Mood (last 10): —" style="-fx-text-fill: #4a5568; -fx-padding: 5 0;"/>
                        
                    </VBox>
                    <VBox styleClass="dashboard-card, action-card" HBox.hgrow="ALWAYS" spacing="15" alignment="CENTER">
                        <Label text="Quick Actions" styleClass="section-title"/>
                        <HBox spacing="20" alignment="CENTER">
                            <Button text="📓 Journal" styleClass="btn-primary" onAction="#handleGoToJournal"/>
                            <Button text="🌿 Habit" styleClass="btn-primary" onAction="#handleGoToHabits"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
