<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.journal.AffichageHabitudeController"
            stylesheets="@../../styles/views/journal.css">

    <!-- ================= EN-TETE ================= -->
    <top>
        <VBox spacing="0">
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                <Button text="⬅ Dashboard" styleClass="cancel-button" onAction="#allerAuDashboard" style="-fx-border-color: transparent; -fx-padding: 6.4 12;"/>
                <VBox spacing="3.2" HBox.hgrow="ALWAYS">
                    <Label text="🌿 Habits" styleClass="title" style="-fx-font-size: 19.2px;"/>
                    <Label text="View, manage, and analyze your habits" styleClass="subtitle" style="-fx-font-size: 10.4px;"/>
                </VBox>
                <Button text="+ New Habit" styleClass="add-test-btn"
                        onAction="#ajouterHabitude" style="-fx-font-size: 11.2px; -fx-font-weight: bold;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>
                <TextField fx:id="searchField"
                           promptText="Search a habit..."
                           prefWidth="240"
                           styleClass="search-field"/>
                <Button fx:id="clearButton" text="❌" styleClass="icon-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="📄 Export PDF" onAction="#exporterPDF" styleClass="export-button"/>
            </HBox>
        </VBox>
    </top>

    <!-- ================= CONTENU ================= -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f5f7fa;">

            <!-- Barre statistiques -->
            <HBox spacing="12" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <padding><Insets top="10" right="30" bottom="10" left="30"/></padding>
                <HBox styleClass="stat-card" alignment="CENTER" prefWidth="120">
                    <VBox alignment="CENTER" spacing="1.6">
                        <Label fx:id="totalHabitudesLabel" text="0" styleClass="stat-number" style="-fx-font-size: 17.6px;"/>
                        <Label text="Habits" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <HBox styleClass="stat-card" alignment="CENTER" prefWidth="120">
                    <VBox alignment="CENTER" spacing="1.6">
                        <Label fx:id="moyenneEnergieLabel" text="—" styleClass="stat-number" style="-fx-font-size: 17.6px;"/>
                        <Label text="Avg Energy" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <HBox styleClass="stat-card" alignment="CENTER" prefWidth="120">
                    <VBox alignment="CENTER" spacing="1.6">
                        <Label fx:id="moyenneStressLabel" text="—" styleClass="stat-number" style="-fx-font-size: 17.6px;"/>
                        <Label text="Avg Stress" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <HBox styleClass="stat-card" alignment="CENTER" prefWidth="120">
                    <VBox alignment="CENTER" spacing="1.6">
                        <Label fx:id="moyenneSommeilLabel" text="—" styleClass="stat-number" style="-fx-font-size: 17.6px;"/>
                        <Label text="Avg Sleep" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Tableau -->
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS" style="-fx-padding: 16;">
                <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 12;">
                    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>

                    <HBox styleClass="section-box" alignment="CENTER_LEFT" spacing="8">
                        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
                        <Label text="🌿  My Habits" styleClass="section-title" style="-fx-font-size: 12.8px;" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <TableView fx:id="habitudeTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-background-radius: 10px;">
                        <columns>
                            <TableColumn fx:id="nomColumn" text="🏷️ Name" prefWidth="160"/>
                            <TableColumn fx:id="emotionColumn" text="💭 Emotion" prefWidth="96"/>
                            <TableColumn fx:id="noteColumn" text="📝 Note" prefWidth="480"/>
                            <TableColumn fx:id="energieColumn" text="⚡ Energy" prefWidth="80"/>
                            <TableColumn fx:id="stressColumn" text="😰 Stress" prefWidth="80"/>
                            <TableColumn fx:id="sommeilColumn" text="😴 Sleep" prefWidth="80"/>
                            <TableColumn fx:id="dateColumn" text="📅 Date" prefWidth="96"/>
                            <TableColumn fx:id="qrColumn" text="👁 See Details" prefWidth="136"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8">
                                <Label text="🌿" style="-fx-font-size: 38.4px; -fx-text-fill: #cbd5e0;"/>
                                <Label text="No habits recorded"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label fx:id="statusLabel" HBox.hgrow="ALWAYS"/>
            <Button text="✏️ Edit" styleClass="edit-btn-header" onAction="#modifierHabitude"/>
            <Button text="🗑️ Delete" styleClass="delete-btn-header" onAction="#supprimerHabitude"/>
            <Button text="📓 Journal" styleClass="refresh-btn" onAction="#allerAuJournal"/>
        </HBox>
    </bottom>
</BorderPane>
