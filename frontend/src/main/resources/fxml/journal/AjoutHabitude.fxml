<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.journal.AjoutHabitudeController"
            stylesheets="@../../styles/views/journal.css">

    <!-- ============ EN-TETE ============ -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="🌿 Add a Habit" styleClass="title" style="-fx-font-size: 24px;"/>
                <Label text="Record a new daily habit" styleClass="subtitle" style="-fx-font-size: 13px;"/>
            </VBox>
        </HBox>
    </top>

    <!-- ============ CONTENU PRINCIPAL ============ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-padding: 20;">
            <VBox spacing="15">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <!-- Section Informations de base -->
                <VBox styleClass="section-box" spacing="15">
                    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
                    <Label text="📋  Habit Information" styleClass="section-title" style="-fx-font-size: 16px;"/>
                    <Separator/>

                    <VBox spacing="6">
                        <Label text="Habit Name *" styleClass="field-label"/>
                        <TextField fx:id="nomHabitudeField"
                                   promptText="Ex: Morning meditation, Sports, Reading..."
                                   styleClass="custom-text-field"/>
                        <Label fx:id="nomErrorLabel" text="⚠ Name is required"
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;" visible="false"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Dominant Emotion *" styleClass="field-label"/>
                        <ComboBox fx:id="emotionComboBox"
                                  promptText="Select an emotion..."
                                  styleClass="custom-combo-box" maxWidth="Infinity"/>
                        <Label fx:id="emotionErrorLabel" text="⚠ Emotion is required"
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;" visible="false"/>
                    </VBox>
                </VBox>

                <!-- Section Niveaux + Note + Date -->
                <VBox styleClass="section-box" spacing="15">
                    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
                    <Label text="📊  Daily Levels" styleClass="section-title" style="-fx-font-size: 16px;"/>
                    <Separator/>

                    <!-- ENERGIE -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="⚡ Energy Level" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="energieValueLabel" text="🟡 5"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Label text="/ 10" styleClass="stat-label"/>
                        </HBox>
                        <Slider fx:id="energieSlider" min="0" max="10" value="5"
                                showTickLabels="true" showTickMarks="true"
                                majorTickUnit="2" blockIncrement="1"/>
                        <Label fx:id="energieIndicateurLabel" text=""
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 3 12 3 12;"
                               visible="false"/>
                    </VBox>

                    <!-- STRESS -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="😰 Stress Level" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="stressValueLabel" text="🟡 5"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Label text="/ 10" styleClass="stat-label"/>
                        </HBox>
                        <Slider fx:id="stressSlider" min="0" max="10" value="5"
                                showTickLabels="true" showTickMarks="true"
                                majorTickUnit="2" blockIncrement="1"/>
                        <Label fx:id="stressIndicateurLabel" text=""
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 3 12 3 12;"
                               visible="false"/>
                    </VBox>

                    <!-- SOMMEIL -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="😴 Sleep Quality" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="sommeilValueLabel" text="🔵 5"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Label text="/ 10" styleClass="stat-label"/>
                        </HBox>
                        <Slider fx:id="sommeilSlider" min="0" max="10" value="5"
                                showTickLabels="true" showTickMarks="true"
                                majorTickUnit="2" blockIncrement="1"/>
                        <Label fx:id="sommeilIndicateurLabel" text=""
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 3 12 3 12;"
                               visible="false"/>
                    </VBox>

                    <!-- Notes -->
                    <VBox spacing="6">
                        <Label text="Personal Notes" styleClass="field-label"/>
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <TextArea fx:id="noteTextArea"
                                      promptText="Describe your habit, your feelings..."
                                      styleClass="custom-text-area" prefRowCount="4" wrapText="true"
                                      HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnVoice" text="🎙" onAction="#startVoiceInput"
                                    style="-fx-font-size: 16px; -fx-background-radius: 50%;"/>
                        </HBox>
                    </VBox>

                    <!-- Date -->
                    <VBox spacing="6">
                        <Label text="Date *" styleClass="field-label"/>
                        <DatePicker fx:id="datePicker" styleClass="custom-combo-box" maxWidth="250"/>
                        <Label fx:id="dateErrorLabel" text="⚠ Date is required"
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;" visible="false"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ============ PIED DE PAGE ============ -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Button text="← Back to List" styleClass="return-button"
                    onAction="#afficherHabitudes" HBox.hgrow="ALWAYS"/>
            <Button text="Cancel" styleClass="cancel-button"
                    onAction="#afficherHabitudes"/>
            <Button text="✅ Save Habit" styleClass="save-button"
                    onAction="#ajouterHabitude"/>
        </HBox>
    </bottom>
</BorderPane>
