<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.admin.AdminReportsController"
            styleClass="dashboard-view" maxHeight="Infinity" maxWidth="Infinity">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 12 20; -fx-background-color: white;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <Button onAction="#handleBack"
                    style="-fx-background-color: #f1f1f1; -fx-background-radius: 50;
                           -fx-padding: 6.4; -fx-cursor: hand;">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="18" iconColor="#2c3e50"/>
                </graphic>
            </Button>
            <VBox spacing="1.6">
                <Label text="Signalements"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="pendingCountLabel" text="Chargement…"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 10.4px;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
            <tabs>
                <!-- Existing Reports Tab -->
                <Tab text="Signalements (Reports)">
                    <content>
                        <ScrollPane fitToWidth="true"
                                    style="-fx-background-color: #f4f7f6; -fx-background: #f4f7f6;">
                            <VBox style="-fx-padding: 24 48;" spacing="12.8">
                                <Label fx:id="emptyLabel"
                                       text="Aucun signalement pour le moment."
                                       style="-fx-font-size: 12.8px; -fx-text-fill: #7f8c8d;"
                                       visible="false" managed="false"/>
                                <VBox fx:id="reportsList" spacing="11.2"/>
                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- New Active Punishments Tab -->
                <Tab text="Punitions Actives (Active Locks)" onSelectionChanged="#loadActiveLocksTab">
                    <content>
                        <ScrollPane fitToWidth="true"
                                    style="-fx-background-color: #f4f7f6; -fx-background: #f4f7f6;">
                            <VBox style="-fx-padding: 24 48;" spacing="12.8">
                                <Label fx:id="emptyLocksLabel"
                                       text="Aucune punition active."
                                       style="-fx-font-size: 12.8px; -fx-text-fill: #7f8c8d;"
                                       visible="false" managed="false"/>
                                <VBox fx:id="locksList" spacing="11.2"/>
                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
