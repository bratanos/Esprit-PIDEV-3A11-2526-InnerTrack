<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innertrack.controller.community.CommunityController"
      maxHeight="Infinity" maxWidth="Infinity"
      spacing="0"
      stylesheets="@../../styles/base/tokens.css,
                   @../../styles/base/root.css,
                   @../../styles/base/typography.css,
                   @../../styles/base/controls.css,
                   @../../styles/views/community.css"
      styleClass="community-view">

    <!-- Header -->
    <HBox styleClass="community-header" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <Button text="← Dashboard" onAction="#handleBack" styleClass="green-btn"/>
        <Label text="🗣️ Community Forum" styleClass="community-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Lock Banner (hidden by default) -->
    <HBox fx:id="lockBannerBox" styleClass="lock-banner" alignment="CENTER" visible="false" managed="false">
        <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
        <Label fx:id="lockBanner" text="" styleClass="lock-banner-text"/>
    </HBox>

    <!-- Main Stack Area -->
    <StackPane VBox.vgrow="ALWAYS" fx:id="mainStackPane">

        <!-- View 1: Topics Hub (Grid) -->
        <VBox fx:id="topicsView" spacing="12" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="🔍 Search in Community..."
                           onAction="#handleSearch" HBox.hgrow="ALWAYS"/>
                <Button text="Search" onAction="#handleSearch" styleClass="btn-reddit-secondary"/>
                <Button text="Create Topic" onAction="#handleCreateTopic" styleClass="btn-reddit-primary"/>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <!-- Use FlowPane for responsive grid -->
                <FlowPane fx:id="topicsGrid" hgap="20" vgap="20" prefWrapLength="800" style="-fx-padding: 4;"/>
            </ScrollPane>
        </VBox>

        <!-- View 2: Individual Thread -->
        <VBox fx:id="threadView" spacing="0" visible="false">
            <HBox style="-fx-background-color: white; -fx-padding: 10 20; -fx-border-color: #edeff1; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                <Button text="← Back to Topics" onAction="#handleBackToTopics" styleClass="btn-reddit-secondary"/>
            </HBox>
            
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <!-- The Topic Post Details Box -->
                    <VBox fx:id="threadTopicBox" styleClass="topic-detail-card" spacing="10">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    </VBox>

                    <!-- The Comments Below -->
                    <TreeView fx:id="commentsTree" VBox.vgrow="ALWAYS" styleClass="comments-tree"/>
                </VBox>
            </ScrollPane>

            <!-- Reply Box for the Thread -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="new-comment-bar">
                <TextField fx:id="newCommentField" promptText="Comment on this topic..."
                           onAction="#handlePostComment" HBox.hgrow="ALWAYS"/>
                <Button text="Post Comment" onAction="#handlePostComment" styleClass="btn-reddit-primary"/>
            </HBox>
        </VBox>

    </StackPane>
</VBox>
