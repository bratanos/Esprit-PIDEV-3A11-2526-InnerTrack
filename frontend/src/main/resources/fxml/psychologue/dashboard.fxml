<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.therapist.TherapistDashboardController"
            stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css,
                         @../../styles/base/typography.css, @../../styles/base/controls.css,
                         @../../styles/themes/theme-light.css, @../../styles/components/sidebar.css,
                         @../../styles/views/dashboard.css"
            styleClass="dashboard-view"
            maxHeight="Infinity" maxWidth="Infinity">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280">
            <VBox styleClass="sidebar-logo" alignment="CENTER">
                <ImageView fitWidth="100" preserveRatio="true">
                    <image><Image url="@../../images/innertracklogo1.png"/></image>
                </ImageView>
            </VBox>

            <VBox styleClass="profile-section">
                <javafx.scene.shape.Circle fx:id="profileCircle" radius="25" styleClass="profile-pic"/>
                <Label fx:id="userFullNameLabel" text="Psychologue" styleClass="profile-name"/>
            </VBox>

            <Separator opacity="0.1"/>

            <VBox spacing="2">
                <Button text="%sidebar.psy.resume" styleClass="sidebar-button, sidebar-button-active" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-home" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="%sidebar.psy.profile" onAction="#handleGoToProfile"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-id-card" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="%sidebar.psy.location" onAction="#handleGoToLocation"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-map-marker-alt" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <!-- Notification button with badge -->
                <StackPane maxWidth="Infinity">
                    <Button text="%sidebar.psy.notifications" onAction="#handleGoToNotifications"
                            styleClass="sidebar-button" maxWidth="Infinity"
                            StackPane.alignment="CENTER_LEFT">
                        <graphic><FontIcon iconLiteral="fas-bell" iconSize="18" iconColor="#ffffff"/></graphic>
                    </Button>
                    <!-- Badge — shown/hidden by controller -->
                    <Label fx:id="notifBadge" text="!"
                           visible="false"
                           style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                  -fx-font-size: 10px; -fx-font-weight: bold;
                                  -fx-background-radius: 50; -fx-padding: 2 6;
                                  -fx-min-width: 18;"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>

                <Button text="%sidebar.messages" onAction="#handleGoToMessages"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-comments" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="🧪 Psy Tests" onAction="#handleGoToTests"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-brain" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="🗣️ Community" onAction="#handleGoToCommunity"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="📰 Articles" onAction="#handleGoToArticles"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-newspaper" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="📅 Events" onAction="#handleGoToEvents"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="far-calendar-alt" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="🤖 Chatbot" onAction="#handleGoToChatbot"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-robot" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>

                <Button text="%sidebar.settings" onAction="#handleGoToSettings"
                        styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-cog" iconSize="18" iconColor="#ffffff"/></graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="%sidebar.logout" styleClass="sidebar-button"
                    maxWidth="Infinity" onAction="#handleLogout">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="18" iconColor="#ffffff"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="30" styleClass="dashboard-container" VBox.vgrow="ALWAYS">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <!-- Header -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox>
                        <Label fx:id="welcomeLabel"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                               text="%dashboard.psy.welcome"/>
                        <Label text="%dashboard.psy.title"
                               style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Pending requests quick alert -->
                    <HBox fx:id="pendingAlert" spacing="8" alignment="CENTER"
                          visible="false" managed="false"
                          style="-fx-background-color: #FFF3CD; -fx-background-radius: 10;
                                 -fx-padding: 8 16; -fx-cursor: hand;"
                          onMouseClicked="#handleGoToNotifications">
                        <FontIcon iconLiteral="fas-bell" iconSize="16" iconColor="#856404"/>
                        <Label fx:id="pendingAlertLabel" text=""
                               style="-fx-text-fill: #856404; -fx-font-size: 13px;"/>
                    </HBox>
                </HBox>

                <!-- Stats Cards -->
                <HBox spacing="20">
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-users" iconSize="24" iconColor="#1d7bed"/>
                        <Label fx:id="totalPatientsLabel" styleClass="stat-value" text="0"/>
                        <Label styleClass="stat-label" text="%dashboard.psy.patients"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-calendar-check" iconSize="24" iconColor="#27ae60"/>
                        <Label fx:id="appointmentsTodayLabel" styleClass="stat-value" text="0"
                               style="-fx-text-fill: #27ae60;"/>
                        <Label styleClass="stat-label" text="%dashboard.psy.appointments"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-envelope-open-text" iconSize="24" iconColor="#FF69B4"/>
                        <Label fx:id="pendingRequestsLabel" styleClass="stat-value" text="0"
                               style="-fx-text-fill: #FF69B4;"/>
                        <Label styleClass="stat-label" text="%dashboard.psy.pending"/>
                    </VBox>
                    <VBox styleClass="dashboard-card, stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-comments" iconSize="24" iconColor="#9b59b6"/>
                        <Label fx:id="totalConsultationsLabel" styleClass="stat-value" text="0"
                               style="-fx-text-fill: #9b59b6;"/>
                        <Label styleClass="stat-label" text="%dashboard.psy.activeConv"/>
                    </VBox>
                </HBox>

                <!-- Profile completeness card -->
                <VBox fx:id="profileIncompleteCard" styleClass="dashboard-card" spacing="12"
                      style="-fx-padding: 20; -fx-background-color: linear-gradient(to right, #FF69B4, #ff8fab);"
                      visible="false" managed="false">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-exclamation-circle" iconSize="22" iconColor="white"/>
                        <VBox spacing="2">
                            <Label text="%dashboard.psy.incomplete.title"
                                   style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: white;"/>
                            <Label text="%dashboard.psy.incomplete.desc"
                                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12px;" wrapText="true"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="%dashboard.psy.incomplete.btn" onAction="#handleGoToProfile"
                                style="-fx-background-color: white; -fx-text-fill: #FF69B4;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Agenda Preview -->
                <VBox styleClass="dashboard-card" spacing="15">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="%dashboard.psy.agenda"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label text="%dashboard.psy.agenda.empty"
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>