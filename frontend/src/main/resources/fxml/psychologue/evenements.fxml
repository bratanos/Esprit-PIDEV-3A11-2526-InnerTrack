<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.therapist.TherapistEvenementController"
            stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css,
                         @../../styles/base/typography.css, @../../styles/base/controls.css,
                         @../../styles/themes/theme-light.css, @../../styles/components/sidebar.css,
                         @../../styles/views/dashboard.css"
            styleClass="dashboard-view"
            maxHeight="Infinity" maxWidth="Infinity">

    <!-- Header -->
    <top>
        <VBox spacing="16" style="-fx-padding: 20 32;">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Button fx:id="btnBack" text="Retour" onAction="#handleBack"
                        style="-fx-background-color: #718096; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;">
                    <graphic><FontIcon iconLiteral="fas-arrow-left" iconSize="14" iconColor="white"/></graphic>
                </Button>
                <Label fx:id="welcomeLabel" text="Bonjour, Dr. ..."
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <Label text="Gestion des Événements"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="16" style="-fx-padding: 0 32 32 32;">
            
            <!-- Search and Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="evenementSearchField" promptText="Rechercher un événement..."
                           prefWidth="250" onAction="#handleEvenementSearch"/>
                <Button text="Rechercher" onAction="#handleEvenementSearch"
                        style="-fx-background-color: #1d7bed; -fx-text-fill: white;
                               -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
                <ComboBox fx:id="evenementStatutCombo" promptText="Statut"
                          prefWidth="150" onAction="#handleEvenementSearch"/>
                <Button text="Réinitialiser" onAction="#resetEvenementFilters"
                        style="-fx-background-color: #f1f1f1; -fx-text-fill: #2c3e50;
                               -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="evenementsTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                <columns>
                    <TableColumn fx:id="colEvenementId"      text="ID"      prefWidth="50"/>
                    <TableColumn fx:id="colEvenementTitre"   text="Titre"   prefWidth="200"/>
                    <TableColumn fx:id="colEvenementDate"    text="Date"    prefWidth="120"/>
                    <TableColumn fx:id="colEvenementLieu"    text="Lieu"    prefWidth="120"/>
                    <TableColumn fx:id="colEvenementStatut"  text="Statut"  prefWidth="100"/>
                    <TableColumn fx:id="colEvenementParticipants" text="Participants" prefWidth="120"/>
                    <TableColumn fx:id="colEvenementActions" text="Actions" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Pagination -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="Précédent" onAction="#handleEvenementPrevPage"
                        style="-fx-background-color: #f1f1f1; -fx-padding: 6 12; -fx-cursor: hand;"/>
                <Label fx:id="evenementPageLabel" text="Page 1" style="-fx-text-fill: #718096;"/>
                <Button text="Suivant" onAction="#handleEvenementNextPage"
                        style="-fx-background-color: #f1f1f1; -fx-padding: 6 12; -fx-cursor: hand;"/>
                <Label fx:id="evenementTotalLabel" text="" style="-fx-text-fill: #718096;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
