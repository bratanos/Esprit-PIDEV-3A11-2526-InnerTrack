<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innertrack.controller.auth.VerifyOtpController"
      spacing="30" alignment="TOP_CENTER"
      maxWidth="400" stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css, @../../styles/base/typography.css, @../../styles/base/controls.css, @../../styles/themes/theme-light.css, @../../styles/views/auth.css"
      styleClass="auth-view">

    <ImageView fitHeight="70" preserveRatio="true">
        <image>
            <Image url="@../../Images/innertracklogo1.png" />
        </image>
    </ImageView>

    <VBox spacing="8" alignment="CENTER">
        <Label text="%auth.verify.title" styleClass="title" />
        <Label fx:id="subtitleLabel" text="%auth.verify.subtitle" styleClass="subtitle" wrapText="true" textAlignment="CENTER" />
    </VBox>

    <VBox spacing="20" alignment="CENTER">
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="otp1" styleClass="otp-box" />
            <TextField fx:id="otp2" styleClass="otp-box" />
            <TextField fx:id="otp3" styleClass="otp-box" />
            <TextField fx:id="otp4" styleClass="otp-box" />
            <TextField fx:id="otp5" styleClass="otp-box" />
            <TextField fx:id="otp6" styleClass="otp-box" />
        </HBox>
        
        <Button text="%auth.verifyButton" fx:id="verifyButton" onAction="#handleVerify" 
                maxWidth="350" styleClass="btn, btn-primary" />
    </VBox>

    <VBox spacing="10" alignment="CENTER">
        <Label fx:id="timerLabel" text="%auth.verify.timer" styleClass="subtitle" />
        <Button text="%auth.resend" fx:id="resendButton" onAction="#handleResend" 
                styleClass="btn, btn-secondary" disable="true" />
    </VBox>

    <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER" />

    <Hyperlink text="%auth.backToLogin" onAction="#goToLogin" styleClass="subtitle" />

</VBox>
