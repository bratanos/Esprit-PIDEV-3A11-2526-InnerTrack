<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innertrack.controller.auth.ForgotPasswordController"
      spacing="24" alignment="TOP_CENTER"
      maxWidth="320" stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css, @../../styles/base/typography.css, @../../styles/base/controls.css, @../../styles/themes/theme-light.css, @../../styles/views/auth.css"
      styleClass="auth-view">

    <ImageView fitHeight="64" preserveRatio="true">
        <image>
            <Image url="@../../Images/innertracklogo1.png" />
        </image>
    </ImageView>

    <VBox spacing="6.4" alignment="CENTER">
        <Label text="%auth.forgot.title" styleClass="title" />
        <Label text="%auth.forgot.subtitle" styleClass="subtitle" wrapText="true" textAlignment="CENTER" />
    </VBox>

    <VBox spacing="16" alignment="CENTER">
        <VBox spacing="4" alignment="CENTER_LEFT">
            <Label text="%auth.email" styleClass="subtitle" />
            <TextField fx:id="emailField" promptText="exemple@email.com" maxWidth="Infinity" />
        </VBox>

        <Button text="%auth.sendCode" onAction="#handleRequestReset" 
                maxWidth="Infinity" styleClass="btn, btn-primary" />
    </VBox>

    <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER" />

    <Hyperlink text="%auth.backToLogin" onAction="#goToLogin" styleClass="text-link" />

</VBox>
