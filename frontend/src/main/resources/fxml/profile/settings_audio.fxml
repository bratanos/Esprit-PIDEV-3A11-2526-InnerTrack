<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innertrack.controller.settings.SettingsAudioController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <Label text="Voix &amp; Audio" style="-fx-font-size: 17.6px; -fx-font-weight: bold; -fx-text-fill: -it-primary;" />
    
    <Separator />

    <VBox spacing="8">
        <Label text="Microphone" style="-fx-font-size: 12.8px; -fx-font-weight: bold;" />
        <Label text="Sélectionnez le périphérique d'entrée pour la dictée vocale." styleClass="text-muted" />
        <ComboBox fx:id="micComboBox" prefWidth="320" promptText="Sélectionner un micro..." />
    </VBox>

    <VBox spacing="12" styleClass="dashboard-card" style="-fx-padding: 16; -fx-background-color: #f1f5f9;">
        <Label text="Test du Micro" style="-fx-font-size: 12.8px; -fx-font-weight: bold;" />
        
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS" spacing="6.4">
                <ProgressBar fx:id="micTestBar" progress="0.0" prefWidth="Infinity" 
                             style="-fx-accent: #8b5cf6;" prefHeight="9.6" />
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-microphone" iconSize="12" iconColor="#64748b" />
                    <Label text="Niveau d'entrée" styleClass="text-muted" style="-fx-font-size: 8.8px;" />
                </HBox>
            </VBox>
            <ToggleButton fx:id="btnTestMic" text="Tester le Micro" onAction="#toggleMicTest" 
                          styleClass="btn-primary" style="-fx-padding: 6.4 16;" />
        </HBox>
    </VBox>

    <VBox spacing="4">
        <Label text="Reconnaissance Vocale (Vosk)" style="-fx-font-size: 11.2px; -fx-font-weight: bold;" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fas-check-circle" iconColor="#48bb78" iconSize="14" />
            <Label text="Modèle Français chargé : vosk-model-fr-0.22" style="-fx-text-fill: #48bb78;" />
        </HBox>
    </VBox>

</VBox>
