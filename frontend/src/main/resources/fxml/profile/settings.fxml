<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.ImagePattern?>

<ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" 
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.profile.ProfileController"
            stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css, @../../styles/base/typography.css, @../../styles/base/controls.css, @../../styles/views/settings.css"
            styleClass="settings-view">
    
    <VBox spacing="24" styleClass="dashboard-container">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40" />
        </padding>

        <!-- Header -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <Button onAction="#handleBack" styleClass="btn-back">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="20" styleClass="icon-back" />
                </graphic>
            </Button>
            <VBox>
                <Label text="%profile.settings.title" style="-fx-font-size: 22.4px; -fx-font-weight: bold; -fx-text-fill: -it-text;" />
                <Label text="%profile.settings.subtitle" style="-fx-text-fill: -it-text-muted;" />
            </VBox>
        </HBox>

        <HBox spacing="24">
            <!-- Profile Card -->
            <VBox styleClass="dashboard-card" spacing="16" prefWidth="280" alignment="CENTER">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30" />
                </padding>
                
                <Label text="%profile.settings.pic" style="-fx-font-weight: bold; -fx-font-size: 12.8px;" />
                
                <StackPane>
                    <Circle fx:id="profileCircle" radius="64" styleClass="profile-pic" />
                    <Button onAction="#handleChangePicture" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 50; -fx-padding: 6.4; -fx-cursor: hand;" StackPane.alignment="BOTTOM_RIGHT">
                        <graphic>
                            <FontIcon iconLiteral="fas-camera" iconSize="20" iconColor="white" />
                        </graphic>
                    </Button>
                </StackPane>
                
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="nameLabel" text="%profile.settings.username" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                    <Label fx:id="roleLabel" text="%profile.settings.role" style="-fx-text-fill: -it-primary; -fx-font-weight: bold;" />
                </VBox>
                
                <Separator />
            </VBox>

            <!-- Details Card (User Info) -->
            <VBox styleClass="dashboard-card" spacing="20" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30" />
                </padding>
                
                <Label text="%profile.settings.info" style="-fx-font-size: 14.4px; -fx-font-weight: bold;" />
                
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    
                    <Label text="%profile.settings.firstName" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="firstNameField" promptText="%profile.settings.firstNamePrompt" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    
                    <Label text="%profile.settings.lastName" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="lastNameField" promptText="%profile.settings.lastNamePrompt" styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    
                    <Label text="%profile.settings.phone" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="phoneField" promptText="%profile.settings.phonePrompt" styleClass="input-field" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    
                    <Label text="%profile.settings.email" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="emailField" editable="false" style="-fx-opacity: 0.7; -fx-background-color: -it-bg;" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>
                
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="%profile.settings.cancelBtn" onAction="#handleBack" styleClass="btn-secondary" style="-fx-padding: 8 20;" />
                    <Button text="%profile.settings.saveBtn" onAction="#handleUpdateProfile" styleClass="btn-primary"
                            style="-fx-padding: 8 20; -fx-font-weight: bold;" />
                </HBox>

            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
