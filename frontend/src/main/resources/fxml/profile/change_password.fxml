<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="24" alignment="TOP_CENTER" styleClass="dashboard-container"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innertrack.controller.profile.ChangePasswordController"
      stylesheets="@../../styles/base/tokens.css, @../../styles/base/root.css, @../../styles/base/typography.css, @../../styles/base/controls.css, @../../styles/themes/theme-light.css, @../../styles/views/settings.css"
      styleClass="settings-view">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <!-- Header -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Button onAction="#handleBack" style="-fx-background-color: #f1f1f1; -fx-background-radius: 50; -fx-padding: 6.4; -fx-cursor: hand;">
            <graphic>
                <FontIcon iconLiteral="fas-arrow-left" iconSize="20" iconColor="#2c3e50" />
            </graphic>
        </Button>
        <VBox>
            <Label text="%profile.changePwd.title" style="-fx-font-size: 22.4px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="%profile.changePwd.subtitle" style="-fx-text-fill: #7f8c8d;" />
        </VBox>
    </HBox>

    <!-- Change Password Card -->
    <VBox styleClass="dashboard-card" spacing="20" maxWidth="400">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40" />
        </padding>
        
        <VBox spacing="8">
            <Label text="%profile.changePwd.current" styleClass="subtitle" />
            <PasswordField fx:id="currentPasswordField" promptText="••••••••" styleClass="input-field" />
        </VBox>

        <VBox spacing="8">
            <Label text="%profile.changePwd.new" styleClass="subtitle" />
            <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="input-field" />
        </VBox>

        <VBox spacing="8">
            <Label text="%profile.changePwd.confirm" styleClass="subtitle" />
            <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="input-field" />
        </VBox>

        <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER" maxWidth=" Infinity" />

        <Button text="%profile.changePwd.updateBtn" onAction="#handleChangePassword" 
                maxWidth="Infinity" 
                style="-fx-background-color: #1d7bed; -fx-text-fill: white; -fx-padding: 9.6 0; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 12.8px; -fx-cursor: hand;" />
    </VBox>
</VBox>
