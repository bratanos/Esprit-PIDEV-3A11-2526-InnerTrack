<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.innertrack.controller.article.CategorieController"
            styleClass="main-container"
            stylesheets="@../../styles/views/article.css">

    <top>
        <VBox styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="9.6">
                <Label text="📁" style="-fx-font-size: 25.6px;"/>
                <VBox>
                    <Label text="Gestion des Catégories" styleClass="page-title"/>
                    <Label text="Organisez vos catégories d'articles" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="sub-nav-bar">
                    <Button text="📰 Articles" onAction="#goToArticles" styleClass="nav-button"/>
                    <Button text="📁 Catégories" onAction="#loadData" styleClass="nav-button, active"/>
                    <Button text="📚 Parcours" onAction="#goToLearningPaths" styleClass="nav-button"/>
                    <Separator orientation="VERTICAL" prefHeight="16"/>
                    <Button text="🏠 Dashboard" onAction="#goToDashboard" styleClass="nav-button-alt"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="16" style="-fx-padding: 16;">
            <VBox spacing="9.6" prefWidth="272" styleClass="sidebar">
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher une catégorie..."
                           styleClass="search-field"/>

                <Button fx:id="btnNew"
                        text="+ Nouvelle Catégorie"
                        onAction="#showAddForm"
                        styleClass="btn-primary"
                        prefWidth="Infinity"
                        prefHeight="32"/>

                <Separator/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox fx:id="categoriesContainer" spacing="6.4"/>
                </ScrollPane>
            </VBox>

            <StackPane HBox.hgrow="ALWAYS">
                <VBox fx:id="emptyState"
                      alignment="CENTER"
                      spacing="12.8"
                      visible="true"
                      style="-fx-padding: 48;
                             -fx-background-color: #ffffff;
                             -fx-background-radius: 12px;">
                    <Label text="📋" style="-fx-font-size: 51.2px; -fx-opacity: 0.3;"/>
                    <Label text="Sélectionnez une catégorie" styleClass="empty-state-text"/>
                    <Label text="ou créez-en une nouvelle pour commencer"
                           style="-fx-font-size: 10.4px; -fx-text-fill: #8a8886;"/>
                </VBox>

                <ScrollPane fx:id="detailScrollPane"
                            fitToWidth="true"
                            visible="false"
                            style="-fx-background: transparent; -fx-background-color: transparent;">

                    <VBox fx:id="detailView" spacing="16" styleClass="detail-panel">
                        <VBox spacing="4.8">
                            <Label fx:id="lblDetailTitle"
                                   text="Nom de la Catégorie"
                                   styleClass="detail-title"/>
                            <Label fx:id="lblDetailDescription"
                                   text="Description de la catégorie"
                                   style="-fx-font-size: 11.2px; -fx-text-fill: #605e5c;"/>
                        </VBox>

                        <Separator/>

                        <GridPane hgap="12" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Nom :" styleClass="detail-label"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="nomField"
                                       promptText="Nom de la catégorie"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       GridPane.columnSpan="2"/>

                            <Label text="Description :" styleClass="detail-label"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextArea fx:id="descField"
                                       promptText="Description (optionnelle)"
                                       prefHeight="72"
                                       wrapText="true"
                                       GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       GridPane.columnSpan="2"/>
                        </GridPane>

                        <HBox spacing="9.6" alignment="CENTER_LEFT">
                            <Button fx:id="btnUpdate"
                                    text="✓ Enregistrer"
                                    onAction="#handleUpdate"
                                    styleClass="btn-primary"
                                    prefWidth="112"/>

                            <Button fx:id="btnDelete"
                                    text="🗑 Supprimer"
                                    onAction="#handleDelete"
                                    styleClass="btn-danger"
                                    prefWidth="112"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Annuler"
                                    onAction="#clearSelection"
                                    styleClass="btn-ghost"/>
                        </HBox>

                        <Separator/>

                        <VBox spacing="4.8"
                              style="-fx-padding: 11.2;
                                     -fx-background-color: #f3f2f1;
                                     -fx-background-radius: 8px;">
                            <Label text="📊 Statistiques" styleClass="text-bold"/>
                            <Label fx:id="lblArticleCount"
                                   text="0 articles dans cette catégorie"
                                   style="-fx-font-size: 10.4px; -fx-text-fill: #605e5c;"/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="8">
                            <Label text="📰 Articles de cette catégorie"
                                   style="-fx-font-weight: bold; -fx-font-size: 10.4px;"/>
                            <VBox fx:id="articlesListBox" spacing="4.8"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </StackPane>
        </HBox>
    </center>
</BorderPane>
