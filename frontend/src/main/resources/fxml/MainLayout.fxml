<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.ImagePattern?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innertrack.controller.auth.MainLayoutController">

    <!-- Styles are handled by ThemeManager -->

    <!-- Navbar -->
    <top>
        <HBox fx:id="navbar" styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <ImageView fx:id="logoView" fitHeight="32" preserveRatio="true">
                <image>
                    <Image url="@../images/innertracklogo1.png" />
                </image>
            </ImageView>
            <Label text="%main.title" styleClass="navbar-brand" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 0 16 0 0;">
                <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-bell" iconSize="20" iconColor="#7f8c8d" />
                    </graphic>
                </Button>
                
                <HBox spacing="8" alignment="CENTER_RIGHT" fx:id="authBox">
                    <Hyperlink text="%main.home" styleClass="navbar-link" onAction="#goToHome" />
                    <Hyperlink text="%main.login" fx:id="loginLink" styleClass="navbar-link" onAction="#goToLogin" />
                    <Hyperlink text="%main.register" fx:id="registerLink" styleClass="navbar-link" onAction="#goToRegister" />
                    <Button fx:id="profileBtn" text="%main.profile" styleClass="btn, btn-secondary" visible="false" />
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentContainer" maxHeight="Infinity" maxWidth="Infinity" />
    </center>

    <!-- Footer -->
    <bottom>
        <StackPane>
            <VBox fx:id="footer" styleClass="footer">
                <Label fx:id="footerLabel" text="%main.footer" styleClass="subtitle" />
            </VBox>
            
            <!-- Vosk Loading Indicator (Bottom Right) -->
            <HBox fx:id="voskLoadingBox" spacing="8" alignment="CENTER_RIGHT" 
                  visible="false" managed="false" StackPane.alignment="BOTTOM_RIGHT"
                  style="-fx-padding: 6.4 12; -fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10; -fx-border-color: #8b5cf6; -fx-border-radius: 10; -fx-border-width: 1;">
                <StackPane.margin>
                    <Insets bottom="10" right="20" />
                </StackPane.margin>
                <Label text="Assistant Vocal: Chargement..." 
                       style="-fx-font-size: 8.8px; -fx-text-fill: #8b5cf6; -fx-font-weight: bold;" />
                <ProgressBar fx:id="voskProgressBar" prefWidth="96" prefHeight="8" 
                             style="-fx-accent: #8b5cf6;" />
            </HBox>
        </StackPane>
    </bottom>

</BorderPane>
