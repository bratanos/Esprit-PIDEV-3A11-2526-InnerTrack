<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="/styles/components/event-style.css"
            fx:controller="com.innertrack.controller.event.WeatherWeekModalController">

    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <top>
        <VBox spacing="4" styleClass="weather-modal-header">
            <Label text="Prévisions météo" styleClass="weather-modal-title"/>
            <Label fx:id="statusLabel" text="Chargement..." styleClass="weather-modal-status"/>
            <Label text="(OpenWeather Free = prévision ~5 jours)" styleClass="weather-modal-hint"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="weather-modal-body">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <ProgressIndicator fx:id="loading" visible="false"/>

            <TableView fx:id="weekTable" prefHeight="260" styleClass="weather-modal-table">
                <columns>
                    <TableColumn fx:id="cDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="cMin" text="Min (°C)" prefWidth="90"/>
                    <TableColumn fx:id="cMax" text="Max (°C)" prefWidth="90"/>
                    <TableColumn fx:id="cDesc" text="Description" prefWidth="240"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="weather-modal-footer">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button text="Fermer" onAction="#close" styleClass="btn-secondary"/>
        </HBox>
    </bottom>

</BorderPane>