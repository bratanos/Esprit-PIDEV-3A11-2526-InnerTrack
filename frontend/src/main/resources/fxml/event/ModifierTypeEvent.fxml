<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.innertrack.controller.event.ModifierTypeEventController"
      prefWidth="560"
      prefHeight="336"
      fillWidth="true"
      styleClass="main-container"
      stylesheets="/styles/components/event-style.css">

    <children>

        <MenuBar VBox.vgrow="NEVER" styleClass="event-menubar"/>

        <AnchorPane VBox.vgrow="ALWAYS" styleClass="event-form-canvas">
            <children>

                <!-- Title -->
                <Label text="Modifier un Type d'Événement"
                       styleClass="event-form-title"
                       AnchorPane.topAnchor="14.4"
                       AnchorPane.leftAnchor="14.4"/>

                <!-- Form stack -->
                <VBox styleClass="event-form-stack"
                      AnchorPane.topAnchor="48"
                      AnchorPane.leftAnchor="14.4"
                      AnchorPane.rightAnchor="14.4"
                      AnchorPane.bottomAnchor="14.4">

                    <VBox styleClass="event-field">
                        <Label text="Libellé:" styleClass="event-field-label"/>
                        <TextField fx:id="libelle_input"
                                   promptText="Ex: Conférence, Atelier, Meetup..."
                                   styleClass="event-input"/>
                    </VBox>

                    <Label fx:id="error_label"
                           visible="false"
                           styleClass="event-error-label"/>

                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="event-actions">
                        <Button text="✏️ Modifier"
                                onAction="#submit"
                                prefWidth="128"
                                prefHeight="30.4"
                                styleClass="btn-secondary"/>

                        <Button text="Annuler"
                                onAction="#back"
                                prefWidth="112"
                                prefHeight="30.4"
                                styleClass="btn-ghost"/>
                    </HBox>

                </VBox>

            </children>
        </AnchorPane>

    </children>
</VBox>