<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.innertrack.controller.event.AfficherEvenementController"
           stylesheets="/styles/components/event-style.css">

    <!-- Ton écran principal -->
    <BorderPane fx:id="rootPane"
                styleClass="main-container">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- TOP -->
        <top>
            <VBox spacing="9.6" styleClass="page-header">
                <HBox alignment="CENTER_LEFT" spacing="9.6">
                    <Label text="📅" style="-fx-font-size: 27.2px;"/>
                    <VBox>
                        <Label text="Gestion des Événements" styleClass="page-title"/>
                        <Label text="Consultez, ajoutez, modifiez et supprimez vos événements" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="weather-card"
                      onMouseClicked="#openWeatherModal"
                      style="-fx-cursor: hand;">
                    <ImageView fx:id="weatherIcon" fitHeight="28.8" fitWidth="28.8" preserveRatio="true"/>
                    <VBox spacing="1.6">
                        <Label fx:id="weatherTitle" text="Météo" styleClass="weather-title"/>
                        <Label fx:id="weatherDetails" text="—" styleClass="weather-details"/>
                    </VBox>
                </HBox>

                <MenuBar styleClass="event-menubar">
                    <menus>
                        <Menu mnemonicParsing="false" text="Navigation">
                            <items>
                                <MenuItem text="Retour au Dashboard" onAction="#backToDashboard"/>
                            </items>
                        </Menu>

                        <Menu fx:id="menuTypeEvent" mnemonicParsing="false" text="Types d'Événements">
                            <items>
                                <MenuItem mnemonicParsing="false"
                                          text="Gérer Types d'événements"
                                          onAction="#handleTypeEvent" />
                            </items>
                        </Menu>

                        <Menu fx:id="menuInscription" mnemonicParsing="false" text="Inscriptions">
                            <items>
                                <MenuItem mnemonicParsing="false"
                                          text="Gérer Inscriptions"
                                          onAction="#goToInscriptions" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </VBox>
        </top>

        <!-- CENTER -->
        <center>
            <VBox spacing="11.2" styleClass="content-area">

                <TableView fx:id="table_events" VBox.vgrow="ALWAYS" styleClass="event-table">
                    <columns>
                        <TableColumn fx:id="col_id" prefWidth="40" text="ID" visible="false" />
                        <TableColumn fx:id="col_title" prefWidth="96" text="Titre" />
                        <TableColumn fx:id="col_description" prefWidth="136" text="Description" />
                        <TableColumn fx:id="col_date" prefWidth="72" text="Date" />
                        <TableColumn fx:id="col_type" prefWidth="96" text="Type" />
                        <TableColumn fx:id="col_capacity" prefWidth="72" text="Capacité" />
                        <TableColumn fx:id="col_status" prefWidth="64" text="Status" />
                        <TableColumn fx:id="dateCreationColumn" prefWidth="96" text="Date Création" />
                        <TableColumn fx:id="col_participer" prefWidth="96" text="Action" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox fx:id="adminActions" spacing="8" alignment="CENTER_LEFT">
                    <Button text="➕ Ajouter Événement"
                            onAction="#handleAjouterEvenement"
                            styleClass="btn-primary"
                            prefHeight="30.4"/>

                    <Button text="✏️ Modifier"
                            onAction="#handleModifierEvenement"
                            styleClass="btn-secondary"
                            prefHeight="30.4"/>

                    <Button text="🗑️ Supprimer"
                            onAction="#deleteSelected"
                            styleClass="btn-danger"
                            prefHeight="30.4"/>
                </HBox>

                <Label fx:id="error_label"
                       visible="false"
                       styleClass="event-error-label"/>
            </VBox>
        </center>

        <!-- IMPORTANT: plus de <right> chat-panel ici -->
    </BorderPane>

    <!-- Overlay Chat (caché par défaut) -->
    <VBox fx:id="chatOverlay"
          visible="false" managed="false"
          spacing="8"
          prefWidth="240" maxWidth="240"
          prefHeight="336" maxHeight="336"
          styleClass="chat-overlay"
          StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <!-- bottom=86 pour laisser la place à la bulle -->
            <Insets top="0" right="18" bottom="1" left="0"/>
        </StackPane.margin>

        <HBox alignment="CENTER_LEFT" spacing="6.4" styleClass="chat-overlay-header">
            <Label text="🤖 Assistant" styleClass="chat-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#toggleChat" styleClass="chat-close-btn"/>
        </HBox>

        <TextArea fx:id="chatArea"
                  editable="false"
                  wrapText="true"
                  prefHeight="224" maxHeight="224"
                  VBox.vgrow="NEVER"
                  styleClass="chat-area"/>

        <HBox spacing="6.4" alignment="CENTER_LEFT">
            <TextField fx:id="chatInput"
                       promptText="Écrivez un message…"
                       HBox.hgrow="ALWAYS"
                       onAction="#sendChatMessage"
                       styleClass="chat-input"/>
            <Button text="Envoyer"
                    onAction="#sendChatMessage"
                    styleClass="btn-secondary"
                    prefHeight="27.2"/>
        </HBox>

        <Label fx:id="chatStatus"
               text="API: déconnectée"
               styleClass="chat-status"/>
    </VBox>

    <!-- Bulle flottante -->
    <Button fx:id="chatBubble"
            text="💬"
            onAction="#toggleChat"
            styleClass="chat-bubble"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0" right="18" bottom="18" left="0"/>
        </StackPane.margin>
    </Button>
</StackPane>