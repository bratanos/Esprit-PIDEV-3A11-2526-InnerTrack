<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.innertrack.controller.event.AfficherTypeEventController"
      prefWidth="800"
      prefHeight="520"
      fillWidth="true"
      styleClass="main-container"
      stylesheets="/styles/components/event-style.css">

    <children>

        <!-- Header (same as Events) -->
        <VBox spacing="9.6" styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <!-- Bouton Retour -->
                <Button text="⬅ Retour"
                        onAction="#handleRetour"
                        prefWidth="96"
                        prefHeight="28"
                        styleClass="btn-secondary"/>

                <Label text="🏷️" style="-fx-font-size: 27.2px;"/>

                <VBox>
                    <Label text="Gestion des Types d'Événements" styleClass="page-title"/>
                    <Label text="Ajoutez, modifiez et supprimez les types d'événements" styleClass="page-subtitle"/>
                </VBox>

            </HBox>
        </VBox>

        <!-- Content -->
        <VBox spacing="11.2" styleClass="content-area" VBox.vgrow="ALWAYS">

            <TableView fx:id="table_types"
                       VBox.vgrow="ALWAYS"
                       styleClass="event-table">

                <columns>
                    <!-- Hidden safely (NO managed attribute) -->
                    <TableColumn fx:id="col_id" text="ID" prefWidth="64" visible="false"/>
                    <TableColumn fx:id="col_libelle" text="Libellé" prefWidth="416"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Buttons row -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="➕ Ajouter"
                        onAction="#handleAjouter"
                        prefWidth="128"
                        prefHeight="30.4"
                        styleClass="btn-primary"/>

                <Button text="✏️ Modifier"
                        onAction="#handleModifier"
                        prefWidth="128"
                        prefHeight="30.4"
                        styleClass="btn-secondary"/>

                <Button text="🗑️ Supprimer"
                        onAction="#handleSupprimer"
                        prefWidth="128"
                        prefHeight="30.4"
                        styleClass="btn-danger"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Refresh"
                        onAction="#refresh"
                        prefWidth="128"
                        prefHeight="30.4"
                        styleClass="btn-success"/>
            </HBox>

            <!-- Error label -->
            <Label fx:id="error_label"
                   visible="false"
                   styleClass="event-error-label"/>

        </VBox>

    </children>
</VBox>