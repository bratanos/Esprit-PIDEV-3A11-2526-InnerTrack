<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.innertrack.controller.event.AfficherTypeEventController"
      prefWidth="1000.0"
      prefHeight="650.0"
      fillWidth="true"
      styleClass="main-container"
      stylesheets="@../../styles/views/event-style.css">

    <children>

        <!-- Header (same as Events) -->
        <VBox spacing="12" styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <!-- Bouton Retour -->
                <Button text="⬅ Retour"
                        onAction="#handleRetour"
                        prefWidth="120"
                        prefHeight="35"
                        styleClass="btn-secondary"/>

                <Label text="🏷️" style="-fx-font-size: 34px;"/>

                <VBox>
                    <Label text="Gestion des Types d'Événements" styleClass="page-title"/>
                    <Label text="Ajoutez, modifiez et supprimez les types d'événements" styleClass="page-subtitle"/>
                </VBox>

            </HBox>
        </VBox>

        <!-- Content -->
        <VBox spacing="14" styleClass="content-area" VBox.vgrow="ALWAYS">

            <TableView fx:id="table_types"
                       VBox.vgrow="ALWAYS"
                       styleClass="event-table">

                <columns>
                    <!-- Hidden safely (NO managed attribute) -->
                    <TableColumn fx:id="col_id" text="ID" prefWidth="80" visible="false"/>
                    <TableColumn fx:id="col_libelle" text="Libellé" prefWidth="520"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Buttons row -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="➕ Ajouter"
                        onAction="#handleAjouter"
                        prefWidth="160"
                        prefHeight="38"
                        styleClass="btn-primary"/>

                <Button text="✏️ Modifier"
                        onAction="#handleModifier"
                        prefWidth="160"
                        prefHeight="38"
                        styleClass="btn-secondary"/>

                <Button text="🗑️ Supprimer"
                        onAction="#handleSupprimer"
                        prefWidth="160"
                        prefHeight="38"
                        styleClass="btn-danger"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Refresh"
                        onAction="#refresh"
                        prefWidth="160"
                        prefHeight="38"
                        styleClass="btn-success"/>
            </HBox>

            <!-- Error label -->
            <Label fx:id="error_label"
                   visible="false"
                   styleClass="event-error-label"/>

        </VBox>

    </children>
</VBox>